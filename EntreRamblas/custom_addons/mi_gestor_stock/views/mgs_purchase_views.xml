<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mgs_purchase_order_list" model="ir.ui.view">
        <field name="name">mgs.purchase.order.list</field>
        <field name="model">mgs.purchase.order</field>
        <field name="arch" type="xml">
            <list string="Pedidos a proveedor" default_order="order_date desc">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="order_date"/>
                <field name="expected_date"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ('ordered', 'partial')"
                       decoration-success="state == 'received'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_mgs_purchase_order_form" model="ir.ui.view">
        <field name="name">mgs.purchase.order.form</field>
        <field name="model">mgs.purchase.order</field>
        <field name="arch" type="xml">
            <form string="Pedido a proveedor" js_class="mgs_clean_form">
                <header>
                    <button name="action_confirm" string="Confirmar pedido" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_receive" string="Recibir" type="object"
                            class="btn-primary" invisible="state not in ('ordered', 'partial')"/>
                    <button name="action_cancel" string="Cancelar" type="object"
                            invisible="state in ('cancelled', 'received')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ordered,received"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="order_date" readonly="state != 'draft'"/>
                            <field name="expected_date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="amount_total" widget="monetary"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Partidas">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_cost"/>
                                    <field name="subtotal" readonly="1"/>
                                    <field name="received_qty" readonly="1"/>
                                    <field name="pending_qty" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mgs_purchase_orders" model="ir.actions.act_window">
        <field name="name">Pedidos a proveedor</field>
        <field name="res_model">mgs.purchase.order</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
