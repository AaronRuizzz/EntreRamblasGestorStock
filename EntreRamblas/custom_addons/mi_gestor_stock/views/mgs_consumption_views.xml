<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Responde «cuántas rosas gasto de verdad», que hoy no se puede ver
         en «Productos más vendidos» porque un ramo de 12 rosas cuenta ahí
         como 1 unidad de «Ramo a medida». Ver models/mgs_consumption.py. -->
    <record id="view_mgs_consumption_graph" model="ir.ui.view">
        <field name="name">mgs.flower.consumption.graph</field>
        <field name="model">mgs.flower.consumption</field>
        <field name="arch" type="xml">
            <graph string="Consumo de flor" type="bar" order="desc" sample="1">
                <field name="product_id"/>
                <field name="quantity" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_mgs_consumption_pivot" model="ir.ui.view">
        <field name="name">mgs.flower.consumption.pivot</field>
        <field name="model">mgs.flower.consumption</field>
        <field name="arch" type="xml">
            <pivot string="Consumo de flor" sample="1">
                <field name="product_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="quantity" type="measure"/>
                <field name="cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Lista de detalle: permite auditar qué llevaba un ramo o un evento
         concretos (pos_order_id / event_id enlazan a la venta o al evento). -->
    <record id="view_mgs_consumption_list" model="ir.ui.view">
        <field name="name">mgs.flower.consumption.list</field>
        <field name="model">mgs.flower.consumption</field>
        <field name="arch" type="xml">
            <list string="Consumo de flor" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="cost" sum="Coste"/>
                <field name="origin"/>
                <field name="partner_id"/>
                <field name="pos_order_id"/>
                <field name="event_id"/>
            </list>
        </field>
    </record>

    <record id="view_mgs_consumption_search" model="ir.ui.view">
        <field name="name">mgs.flower.consumption.search</field>
        <field name="model">mgs.flower.consumption</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="categ_id"/>
                <filter name="origin_pos" string="Venta suelta" domain="[('origin', '=', 'pos')]"/>
                <filter name="origin_bouquet" string="Ramos" domain="[('origin', '=', 'bouquet')]"/>
                <filter name="origin_event" string="Eventos y encargos" domain="[('origin', '=', 'event')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_by_product" string="Producto" context="{'group_by': 'product_id'}"/>
                    <filter name="group_by_category" string="Categoría" context="{'group_by': 'categ_id'}"/>
                    <filter name="group_by_origin" string="Origen" context="{'group_by': 'origin'}"/>
                    <filter name="group_by_month" string="Mes" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mgs_consumption" model="ir.actions.act_window">
        <field name="name">Consumo de flor</field>
        <field name="res_model">mgs.flower.consumption</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="view_mgs_consumption_search"/>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'sequence':1,'view_mode':'graph','view_id': ref('view_mgs_consumption_graph')}),
            (0,0,{'sequence':2,'view_mode':'pivot','view_id': ref('view_mgs_consumption_pivot')}),
            (0,0,{'sequence':3,'view_mode':'list','view_id': ref('view_mgs_consumption_list')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay ventas registradas.</p>
            <p>En cuanto se venda un ramo o se entregue un evento, aquí sale cuánta
               flor se ha gastado de verdad, tallo a tallo.</p>
        </field>
    </record>
</odoo>
