<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mgs_bouquet_recipe_list" model="ir.ui.view">
        <field name="name">mgs.bouquet.recipe.list</field>
        <field name="model">mgs.bouquet.recipe</field>
        <field name="arch" type="xml">
            <list string="Recetas de ramo">
                <field name="name"/>
                <field name="list_price"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_mgs_bouquet_recipe_form" model="ir.ui.view">
        <field name="name">mgs.bouquet.recipe.form</field>
        <field name="model">mgs.bouquet.recipe</field>
        <field name="arch" type="xml">
            <form string="Receta de ramo">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ej. Ramo novia clásico"/></h1>
                    </div>
                    <group>
                        <field name="list_price"/>
                        <field name="note" placeholder="Notas para quien monte el ramo"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="quantity"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mgs_bouquet_recipes" model="ir.actions.act_window">
        <field name="name">Recetas de ramo</field>
        <field name="res_model">mgs.bouquet.recipe</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay ninguna receta.</p>
            <p>Guarda aquí las composiciones que se repiten («Ramo novia clásico»,
               «Centro pequeño»...) para tenerlas a un toque en el TPV. Se puede
               seguir ajustando cada vez antes de cobrar.</p>
        </field>
    </record>
</odoo>
