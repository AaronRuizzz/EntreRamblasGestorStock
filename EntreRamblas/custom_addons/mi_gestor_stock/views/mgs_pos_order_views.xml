<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Informes → Tickets: registro de tickets Y de ventas en el mismo
         sitio. La lista es el registro de tickets (número, fecha, hora,
         importe); el formulario de cada uno es el registro de la venta
         (sus líneas, impuestos y pagos) — así se ve «la venta, el ticket,
         la fecha y la hora» sin saltar entre dos pantallas distintas.

         Solo lectura (create/edit/delete a false): un ticket no se edita ni
         se borra desde aquí — para corregir una venta ya cobrada está
         Informes → Registrar corrección.
         ============================================================ -->
    <record id="view_mgs_pos_order_list" model="ir.ui.view">
        <field name="name">pos.order.list.mgs</field>
        <field name="model">pos.order</field>
        <field name="arch" type="xml">
            <list string="Tickets" create="0" edit="0" delete="0" default_order="date_order desc">
                <field name="name" string="Ticket"/>
                <field name="date_order" string="Fecha y hora"/>
                <field name="partner_id" string="Cliente"/>
                <field name="amount_total" string="Total" widget="monetary"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('paid', 'done', 'invoiced')"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_mgs_pos_order_form" model="ir.ui.view">
        <field name="name">pos.order.form.mgs</field>
        <field name="model">pos.order</field>
        <field name="arch" type="xml">
            <form string="Ticket" create="0" edit="0" delete="0" js_class="mgs_clean_form">
                <header>
                    <button name="%(action_report_mgs_pos_order_receipt)d" type="action"
                            string="Ver ticket (PDF)" class="btn-primary"/>
                    <button name="action_mgs_reprint_ticket" type="object"
                            string="Reimprimir en la térmica"
                            invisible="state not in ('paid', 'done', 'invoiced')"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" string="Ticket"/>
                            <field name="date_order" string="Fecha y hora"/>
                            <field name="partner_id" string="Cliente"/>
                        </group>
                        <group>
                            <field name="state" widget="badge"/>
                            <field name="amount_total" widget="monetary"/>
                            <field name="account_move" string="Factura" invisible="not account_move"/>
                            <field name="refunded_order_id" string="Rectifica el ticket"
                                   invisible="not refunded_order_id"/>
                        </group>
                    </group>
                    <separator string="Líneas de la venta"/>
                    <field name="lines" readonly="1">
                        <list>
                            <field name="full_product_name" string="Producto"/>
                            <field name="qty" string="Cantidad"/>
                            <field name="price_unit" string="Precio"/>
                            <field name="discount" string="Dto. %"/>
                            <field name="price_subtotal_incl" string="Subtotal (con IVA)" widget="monetary"/>
                        </list>
                    </field>
                    <separator string="Pagos"/>
                    <field name="payment_ids" readonly="1">
                        <list>
                            <field name="payment_date" string="Fecha"/>
                            <field name="payment_method_id" string="Método"/>
                            <field name="amount" widget="monetary"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mgs_pos_order_search" model="ir.ui.view">
        <field name="name">pos.order.search.mgs</field>
        <field name="model">pos.order</field>
        <field name="arch" type="xml">
            <search string="Tickets">
                <field name="name" string="Ticket"/>
                <field name="partner_id" string="Cliente"/>
                <filter name="filter_date" date="date_order" string="Fecha"/>
                <separator/>
                <filter string="No canceladas" name="not_cancelled" domain="[('state', '!=', 'cancel')]"/>
                <group expand="1" string="Agrupar por">
                    <filter string="Día" name="group_day" context="{'group_by': 'date_order:day'}"/>
                    <filter string="Mes" name="group_month" context="{'group_by': 'date_order:month'}"/>
                    <filter string="Cliente" name="group_partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mgs_pos_orders" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">pos.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mgs_pos_order_search"/>
        <field name="context">{'search_default_not_cancelled': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_mgs_pos_order_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_mgs_pos_order_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay tickets registrados.</p>
            <p>En cuanto se cobre en el TPV, aquí aparecerá cada venta con su fecha y hora.</p>
        </field>
    </record>
</odoo>
