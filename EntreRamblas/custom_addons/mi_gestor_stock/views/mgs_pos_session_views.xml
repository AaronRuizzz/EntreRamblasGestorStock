<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Cierres de caja pasados, de solo lectura.

         Antes de quitar el kanban nativo de cajas del menú «Vender»
         (ux_defaults.xml lo deja fuera junto al resto de menús nativos),
         ese kanban era también el único sitio desde el que se llegaba a
         las sesiones ya cerradas. Sin esta pantalla, revisar el arqueo
         de un día concreto habría dejado de ser posible.
         ============================================================ -->
    <record id="view_mgs_pos_session_list" model="ir.ui.view">
        <field name="name">pos.session.list.mgs</field>
        <field name="model">pos.session</field>
        <field name="arch" type="xml">
            <list string="Cierres de caja" create="0" edit="0" delete="0" default_order="stop_at desc">
                <field name="name"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="start_at"/>
                <field name="stop_at"/>
                <field name="cash_register_balance_end_real" string="Efectivo contado"/>
                <field name="cash_register_difference" string="Diferencia"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'closed'"
                       decoration-warning="state in ('opened', 'closing_control')"/>
            </list>
        </field>
    </record>

    <record id="view_mgs_pos_session_form" model="ir.ui.view">
        <field name="name">pos.session.form.mgs</field>
        <field name="model">pos.session</field>
        <field name="arch" type="xml">
            <form string="Cierre de caja" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="user_id"/>
                        <field name="state" widget="statusbar"/>
                        <field name="start_at"/>
                        <field name="stop_at"/>
                        <field name="cash_register_balance_start"/>
                        <field name="cash_register_balance_end"/>
                        <field name="cash_register_balance_end_real"/>
                        <field name="cash_register_difference"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mgs_pos_sessions" model="ir.actions.act_window">
        <field name="name">Cierres de caja</field>
        <field name="res_model">pos.session</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_mgs_pos_session_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_mgs_pos_session_form')})]"/>
        <field name="context">{}</field>
    </record>
</odoo>
