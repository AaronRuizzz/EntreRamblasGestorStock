<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sequence_mgs_inventory_count" model="ir.sequence">
        <field name="name">Recuento físico</field><field name="code">mgs.inventory.count</field>
        <field name="prefix">REC/</field><field name="padding">5</field>
    </record>
    <record id="rule_mgs_count_company" model="ir.rule">
        <field name="name">Recuentos de la compañía</field><field name="model_id" ref="model_mgs_inventory_count"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_mgs_count_line_company" model="ir.rule">
        <field name="name">Líneas de recuento de la compañía</field><field name="model_id" ref="model_mgs_inventory_count_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="view_mgs_count_list" model="ir.ui.view">
        <field name="name">mgs.inventory.count.list</field><field name="model">mgs.inventory.count</field>
        <field name="arch" type="xml"><list>
            <field name="name"/><field name="location_id"/><field name="state"/>
            <field name="prepared_at"/><field name="applied_at"/><field name="applied_by"/>
        </list></field>
    </record>
    <record id="view_mgs_count_form" model="ir.ui.view">
        <field name="name">mgs.inventory.count.form</field><field name="model">mgs.inventory.count</field>
        <field name="arch" type="xml"><form js_class="mgs_clean_form">
            <header>
                <button name="action_prepare" type="object" string="Preparar partidas" class="btn-primary" invisible="state != 'draft'"/>
                <button name="action_prepare" type="object" string="Recargar y volver a contar" invisible="state != 'counting'"
                        confirm="Se borrarán las cantidades anotadas para consultar las existencias actuales. ¿Continuar?"/>
                <button name="action_apply" type="object" string="Aplicar diferencias" class="btn-primary" invisible="state != 'counting'"
                        confirm="Se ajustarán las existencias a las cantidades revisadas. ¿Aplicar el recuento?"/>
                <field name="state" widget="statusbar"/>
                <button name="action_cancel" type="object" string="Cancelar recuento" invisible="state in ['done', 'cancelled']"/>
            </header>
            <sheet>
                <h1><field name="name"/></h1>
                <group><field name="company_id" invisible="1"/>
                    <field name="location_id" readonly="state != 'draft'"/>
                    <field name="note" readonly="state != 'draft'"/>
                    <field name="prepared_at"/><field name="applied_at"/><field name="applied_by"/>
                    <field name="cancelled_at" invisible="state != 'cancelled'"/>
                    <field name="cancelled_by" invisible="state != 'cancelled'"/>
                </group>
                <p>Cuenta por partida y marca cada línea como revisada, también cuando haya cero unidades.
                   Si se vende, recibe o reserva mercancía durante el recuento, recarga y vuelve a contar.
                   Para mercancía nueva sin partida registrada utiliza Recepción.</p>
                <field name="line_ids" readonly="state != 'counting'">
                    <list editable="bottom" create="false" delete="false" decoration-warning="difference != 0">
                        <field name="product_id"/><field name="lot_id"/><field name="location_id"/>
                        <field name="expected_qty"/><field name="counted_qty"/><field name="uom_id"/>
                        <field name="difference"/><field name="checked"/>
                    </list>
                </field>
                <field name="move_ids" invisible="state != 'done'" readonly="1">
                    <list create="false" delete="false"><field name="product_id"/><field name="quantity"/>
                        <field name="location_id"/><field name="location_dest_id"/><field name="state"/>
                    </list>
                </field>
            </sheet>
        </form></field>
    </record>
    <record id="action_mgs_inventory_counts" model="ir.actions.act_window">
        <field name="name">Recuentos físicos</field><field name="res_model">mgs.inventory.count</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
