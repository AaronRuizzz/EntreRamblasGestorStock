<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Gestor de Stock — única app visible del sistema.
         Flujos: Vender · Eventos y encargos · Recepción ·
         Stock (Panel/Productos/Alertas/Alta de catálogo) ·
         Mermas · Informes · Configuración.
         El TPV sigue instalado y registrando ventas, pero se abre
         aparte a pantalla completa (/pos/ui), no desde este menú.
         ============================================================ -->
    <!-- La acción va en el propio menú raíz: al pulsar "Gestor de Stock" en la
         barra superior (o el icono en el lanzador de apps) se abre la página de
         inicio. Odoo solo desciende al primer hijo con acción cuando la app NO
         tiene la suya (web/models/ir_ui_menu.py, load_web_menus), así que
         poniéndola aquí no hace falta un menú "Inicio" ocupando sitio. -->
    <menuitem id="menu_mgs_root" name="Gestor de Stock" sequence="1"
              action="action_mgs_home"
              web_icon="mi_gestor_stock,static/description/icon.png"/>

    <menuitem id="menu_mgs_sell" name="Vender" parent="menu_mgs_root"
              action="action_mgs_open_pos" sequence="5" groups="mi_gestor_stock.group_mgs_user"/>
    <menuitem id="menu_mgs_events" name="Eventos y encargos" parent="menu_mgs_root"
              action="action_mgs_events" sequence="7" groups="mi_gestor_stock.group_mgs_manager"/>
    <menuitem id="menu_mgs_reception" name="Recepción" parent="menu_mgs_root"
              action="action_mgs_reception" sequence="10" groups="mi_gestor_stock.group_mgs_manager"/>

    <menuitem id="menu_mgs_stock" name="Stock" parent="menu_mgs_root" sequence="20"/>
    <!-- De uso diario a de una sola vez, de 10 en 10, sin secuencias repetidas. -->
    <menuitem id="menu_mgs_stock_panel" name="Panel" parent="menu_mgs_stock"
              action="action_mgs_stock_dashboard" sequence="10"/>
    <menuitem id="menu_mgs_stock_products" name="Productos" parent="menu_mgs_stock"
              action="action_mgs_products" sequence="20"/>
    <menuitem id="menu_mgs_stock_alerts" name="Alertas" parent="menu_mgs_stock"
              action="action_mgs_alerts" sequence="40"/>
    <menuitem id="menu_mgs_catalog_import" name="Alta de catálogo" parent="menu_mgs_stock"
              action="action_catalog_import" sequence="100" groups="mi_gestor_stock.group_mgs_manager"/>

    <menuitem id="menu_mgs_scrap" name="Mermas" parent="menu_mgs_root" action="action_mgs_scrap" sequence="25"/>

    <menuitem id="menu_mgs_reports" groups="mi_gestor_stock.group_mgs_manager" name="Informes" parent="menu_mgs_root" sequence="30"/>
    <menuitem id="menu_mgs_reports_sales" name="Ventas y balance" parent="menu_mgs_reports"
              action="action_mgs_report_sales" sequence="10"/>
    <menuitem id="menu_mgs_reports_top" name="Productos más vendidos" parent="menu_mgs_reports"
              action="action_mgs_report_top_products" sequence="20"/>
    <menuitem id="menu_mgs_reports_consumption" name="Consumo de flor" parent="menu_mgs_reports"
              action="action_mgs_consumption" sequence="25"/>
    <menuitem id="menu_mgs_reports_monthly" name="Informe mensual (PDF)" parent="menu_mgs_reports"
              action="action_mgs_monthly_report" sequence="30"/>
    <menuitem id="menu_mgs_reports_sessions" name="Cierres de caja" parent="menu_mgs_reports"
              action="action_mgs_pos_sessions" sequence="40"/>

    <!-- Configuración: solo para el administrador. Los lectores, la impresora
         y el cajón se ajustan una vez al montar la tienda; el uso diario no
         pasa por aquí. -->
    <menuitem id="menu_mgs_settings" name="Configuración" parent="menu_mgs_root"
              sequence="40" groups="mi_gestor_stock.group_mgs_manager"/>
    <menuitem id="menu_mgs_settings_devices" name="Dispositivos" parent="menu_mgs_settings"
              action="action_mgs_config" sequence="10" groups="mi_gestor_stock.group_mgs_manager"/>
    <menuitem id="menu_mgs_settings_backups" name="Copias de seguridad" parent="menu_mgs_settings"
              action="action_mgs_backups" sequence="20" groups="mi_gestor_stock.group_mgs_manager"/>
    <menuitem id="menu_mgs_hardware_jobs" name="Impresiones y aperturas" parent="menu_mgs_settings"
              action="action_mgs_hardware_jobs" sequence="30" groups="mi_gestor_stock.group_mgs_manager"/>
</odoo>
