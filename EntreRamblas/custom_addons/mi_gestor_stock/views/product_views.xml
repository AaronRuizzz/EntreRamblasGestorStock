<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Ficha de producto simplificada para Floristería
         Adaptada para uso directo, limpio y sin elementos distractores
         ============================================================ -->
    <record id="product_template_only_form_view_simplified" model="ir.ui.view">
        <field name="name">product.template.form.simplified.floristeria</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="priority" eval="90"/>
        <field name="arch" type="xml">

            <!-- 0. Menos ruido en el panel de control: los productos se crean en
                 Recepción, y duplicar una ficha no tiene sentido aquí.
                 js_class="mgs_clean_form" quita además el indicador de guardado
                 y el engranaje de acciones (Duplicar/Exportar/Informe de
                 tarifas...): no hace falta ninguno desde aquí. -->
            <xpath expr="//form" position="attributes">
                <attribute name="create">false</attribute>
                <attribute name="duplicate">false</attribute>
                <attribute name="js_class">mgs_clean_form</attribute>
            </xpath>

            <!-- 0bis. Botones de cabecera que inyecta `stock` («Actualizar
                 cantidad», «Reabastecer»): van con position="before" sobre
                 //header/button, así que se escapan del xpath de abajo que
                 apunta a action_open_label_layout. El segundo se localiza
                 por su hermano siguiente, no por su nombre: stock lo
                 declara con la sintaxis de sustitución de acción por xmlid,
                 así que en la vista ya combinada lleva el id numérico
                 resuelto, no un nombre reconocible - y Odoo 18 además
                 prohíbe usar @string como selector de herencia. -->
            <xpath expr="//header/button[@name='action_update_quantity_on_hand']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_update_quantity_on_hand']/following-sibling::button[1]"
                   position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- 0ter. Caja de botones inteligentes (Reglas de precio, Documentos,
                 Disponible, Previsto, Reglas de reordenamiento, Movimientos,
                 Nº de serie, Ubicaciones...): nada de eso es del día a día de
                 la tienda; lo que hace falta está en el grupo "Existencias y
                 caducidad" de más abajo, con datos propios. -->
            <xpath expr="//div[@name='button_box']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- 0quater: sin seguidores/mensajes en la ficha de producto. -->
            <xpath expr="//chatter" position="replace"/>

            <!-- 1. Ocultar estrella de favoritos y checks técnicos de la cabecera -->
            <xpath expr="//field[@name='is_favorite']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='options']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- 2. Ocultar selector de tipo de producto en cabecera -->
            <xpath expr="//field[@name='type']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- 3. Ocultar botón 'Imprimir etiquetas' de la cabecera -->
            <xpath expr="//header//button[@name='action_open_label_layout']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- 4. Reestructurar Información General en dos columnas limpias y equilibradas -->
            <xpath expr="//group[@name='group_general']" position="replace">
                <group name="group_general_floristeria" string="Precios y Categoría">
                    <label for="list_price" string="Precio de Venta (€)"/>
                    <div name="list_price_uom" class="d-flex align-items-center gap-2">
                        <field name="list_price" class="oe_inline" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                    </div>
                    <field name="standard_price" string="Precio de coste (€)" widget="monetary"
                           options="{'currency_field': 'cost_currency_id', 'field_digits': True}"/>
                    <field name="categ_id" string="Categoría"/>
                    <!-- Ramo/composición: el TPV pregunta de qué está hecho y
                         descuenta cada material (models/mgs_bouquet.py). -->
                    <field name="mgs_is_composition" string="Ramo o composición a medida"/>
                    <!-- Alquiler para eventos: sale y vuelve (models/mgs_event.py). -->
                    <field name="mgs_rental_ok" string="Se alquila para eventos"/>
                    <field name="mgs_rental_deposit" string="Fianza por unidad (€)"
                           widget="monetary" options="{'currency_field': 'currency_id'}"
                           invisible="not mgs_rental_ok"/>
                    <!-- Campos técnicos necesarios para lógica interna en modo invisible -->
                    <field name="type" invisible="1"/>
                    <field name="is_storable" invisible="1"/>
                    <field name="sale_ok" invisible="1"/>
                    <field name="active" invisible="1"/>
                </group>
            </xpath>

            <xpath expr="//group[@name='group_standard_price']" position="replace">
                <group name="group_stock_floristeria" string="Código y Referencia">
                    <field name="barcode" string="Código de barras" placeholder="Escanear con pistola Honeywell..."/>
                    <field name="default_code" string="Referencia interna"/>
                    <!-- Hardware: código interno para productos sin EAN del
                         proveedor + etiqueta en la térmica de 80 mm
                         (models/mgs_config.py). -->
                    <button name="action_mgs_generate_barcode" type="object"
                            string="Generar código interno" class="btn-link ps-0"
                            colspan="2" invisible="barcode"/>
                    <button name="action_mgs_print_label" type="object"
                            string="Imprimir etiqueta" class="btn-link ps-0"
                            colspan="2" invisible="not barcode"/>
                    <!-- Campos técnicos en modo invisible -->
                    <field name="currency_id" invisible="1"/>
                    <field name="cost_currency_id" invisible="1"/>
                    <field name="product_variant_id" invisible="1"/>
                </group>
            </xpath>

            <!-- 4bis. Existencias, caducidad y avisos -->
            <xpath expr="//group[@name='group_stock_floristeria']" position="after">
                <group name="group_mgs_stock" string="Existencias y caducidad">
                    <field name="qty_available" string="Existencias" readonly="1"/>
                    <field name="mgs_reception_date" readonly="1"/>
                    <field name="mgs_expiry_date"/>
                    <field name="mgs_low_stock" invisible="1"/>
                    <field name="mgs_expired" invisible="1"/>
                    <field name="mgs_alert_count" invisible="1"/>
                    <button name="action_mgs_open_alerts" type="object" class="btn-link ps-0"
                            string="Configurar avisos de este producto"/>
                </group>
            </xpath>

            <!-- 5. Ocultar notas internas si no se usan para evitar recuadros vacíos -->
            <xpath expr="//group[@name='internal_notes']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- 6. Ocultar pestañas técnicas (Ventas, Compra, Inventario) para ir directo al grano -->
            <xpath expr="//page[@name='sales']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='purchase']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='inventory']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- 6bis. "Punto de venta" (categoría de TPV, "para pesar"...):
                 configuración de fondo, no algo que se toque a diario desde
                 la ficha del producto. (La pestaña "Contabilidad" de
                 `account` no hace falta tocarla aquí: cuelga de
                 product.product_template_form_view, una vista distinta de
                 la que usa esta pantalla, product_template_only_form_view —
                 nunca ha estado presente en esta ficha.) -->
            <xpath expr="//page[@name='pos']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

    <!-- ============================================================
         Stock: lista y buscador propios
         ============================================================ -->
    <record id="view_mgs_product_list" model="ir.ui.view">
        <field name="name">product.template.list.mgs</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <!-- create="false": los productos se dan de alta en Recepción
                 (modo "Producto nuevo"), que además les asigna el código de
                 barras. Aquí solo se consultan y se editan. -->
            <list string="Stock" create="false"
                  decoration-danger="mgs_low_stock" decoration-warning="mgs_expired">
                <field name="name" string="Producto"/>
                <field name="barcode" optional="show"/>
                <field name="categ_id" string="Categoría" optional="show"/>
                <field name="qty_available" string="Existencias"/>
                <field name="mgs_expiry_date" string="Caduca"/>
                <field name="mgs_reception_date" string="Recibido" optional="hide"/>
                <field name="list_price" string="PVP" widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="mgs_low_stock" column_invisible="True"/>
                <field name="mgs_expired" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_mgs_product_search" model="ir.ui.view">
        <field name="name">product.template.search.mgs</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <search string="Stock">
                <field name="name" string="Producto"
                       filter_domain="['|', '|', ('default_code','ilike',self), ('name','ilike',self), ('barcode','ilike',self)]"/>
                <field name="categ_id" filter_domain="[('categ_id','child_of',raw_value)]"/>
                <separator/>
                <filter string="Bajo mínimo" name="filter_mgs_low_stock"
                        domain="[('mgs_low_stock','=',True)]"/>
                <filter string="Caducados" name="filter_mgs_expired"
                        domain="[('mgs_expired','=',True)]"/>
                <separator/>
                <filter string="Archivados" name="inactive" domain="[('active','=',False)]"/>
                <group expand="1" string="Agrupar por">
                    <filter string="Categoría" name="group_categ_id" context="{'group_by':'categ_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mgs_products" model="ir.actions.act_window">
        <field name="name">Productos</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <!-- Solo productos almacenables: fuera los técnicos que instalan
             el TPV / la localización fiscal (Propinas, DUA Valoración...),
             que no son is_storable y no son inventario real. -->
        <field name="domain">[('is_storable','=',True)]</field>
        <field name="context">{'search_default_group_categ_id': 1}</field>
        <field name="search_view_id" ref="view_mgs_product_search"/>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'sequence':1,'view_mode':'list','view_id': ref('view_mgs_product_list')}),
            (0,0,{'sequence':2,'view_mode':'form'})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay productos.</p>
            <p>Se dan de alta desde Recepción, en el modo «Producto nuevo».</p>
        </field>
    </record>
</odoo>
