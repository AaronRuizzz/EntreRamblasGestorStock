<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Historial de correcciones: solo lectura, sin crear ni borrar
         desde la lista. Se registran por el asistente
         (action_mgs_correction_wizard), que es el único camino:
         mgs.correction.create() exige superusuario y write() falla
         siempre (models/mgs_correction.py).
         ============================================================ -->
    <record id="view_mgs_correction_list" model="ir.ui.view">
        <field name="name">mgs.correction.list</field>
        <field name="model">mgs.correction</field>
        <field name="arch" type="xml">
            <list string="Correcciones" create="0" edit="0" delete="0" default_order="date desc">
                <!-- Sin «Nuevo»: una corrección no se teclea en la lista, se
                     registra por el asistente (menú «Registrar corrección»),
                     que es quien valida la devolución vinculada y ajusta la
                     caja si toca. Un botón de cabecera aquí no serviría: con
                     la lista vacía Odoo muestra el panel de «todavía no hay
                     nada» y la cabecera no se dibuja, justo cuando hace falta. -->
                <field name="name"/>
                <field name="date"/>
                <field name="correction_type"/>
                <field name="original_order_id" optional="show"/>
                <field name="return_order_id" optional="show"/>
                <field name="original_method_id" optional="hide"/>
                <field name="corrected_method_id" optional="hide"/>
                <field name="original_value" optional="hide"/>
                <field name="corrected_value"/>
                <field name="resulting_value" optional="hide"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="result_note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_mgs_correction_form" model="ir.ui.view">
        <field name="name">mgs.correction.form</field>
        <field name="model">mgs.correction</field>
        <field name="arch" type="xml">
            <form string="Corrección" create="0" edit="0" delete="0" js_class="mgs_clean_form">
                <sheet>
                    <div class="alert alert-info" role="status">
                        Una corrección registrada no se modifica ni se borra: si hubo un error
                        en ella, se registra otra. La operación original se conserva siempre.
                    </div>
                    <h1><field name="name" readonly="1"/></h1>
                    <group>
                        <group>
                            <field name="correction_type" readonly="1"/>
                            <field name="date" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="original_value" readonly="1"/>
                            <field name="corrected_value" readonly="1"/>
                            <field name="resulting_value" readonly="1"/>
                        </group>
                    </group>
                    <group string="Operaciones" invisible="correction_type != 'sale'">
                        <field name="original_order_id" readonly="1"/>
                        <field name="return_order_id" readonly="1"/>
                        <field name="new_sale_order_id" readonly="1"/>
                    </group>
                    <group string="Reclasificación de cobro" invisible="correction_type != 'payment_method'">
                        <field name="original_payment_id" readonly="1"/>
                        <field name="original_method_id" readonly="1"/>
                        <field name="corrected_method_id" readonly="1"/>
                        <field name="amount" readonly="1"/>
                        <field name="session_id" readonly="1"/>
                        <field name="session_was_open" readonly="1"/>
                        <field name="statement_line_id" readonly="1"/>
                    </group>
                    <group string="Motivo">
                        <field name="reason" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Resultado">
                        <field name="result_note" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mgs_correction_search" model="ir.ui.view">
        <field name="name">mgs.correction.search</field>
        <field name="model">mgs.correction</field>
        <field name="arch" type="xml">
            <search string="Correcciones">
                <field name="name"/>
                <field name="original_order_id"/>
                <field name="reason"/>
                <filter name="filter_sale" string="De venta"
                        domain="[('correction_type', '=', 'sale')]"/>
                <filter name="filter_payment" string="De método de pago"
                        domain="[('correction_type', '=', 'payment_method')]"/>
                <filter name="filter_date" date="date" string="Fecha"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Tipo" name="group_type" context="{'group_by': 'correction_type'}"/>
                    <filter string="Confirmada por" name="group_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ Asistente ============ -->
    <record id="view_mgs_correction_wizard_form" model="ir.ui.view">
        <field name="name">mgs.correction.wizard.form</field>
        <field name="model">mgs.correction.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar una corrección">
                <p class="text-muted">
                    Las ventas no se borran. Un error se arregla con una operación nueva y
                    aquí queda por qué: la devolución (y la venta correcta, si se rehízo), o
                    la reclasificación del cobro al método que de verdad se usó.
                </p>
                <group>
                    <field name="correction_type" widget="radio"/>
                    <field name="reason" placeholder="Qué pasó y por qué se corrige."/>
                </group>
                <group string="Venta que se corrige" invisible="correction_type != 'sale'">
                    <field name="original_order_id" required="correction_type == 'sale'"/>
                    <field name="return_order_id" required="correction_type == 'sale'"/>
                    <field name="new_sale_order_id"/>
                    <div class="text-muted" colspan="2">
                        La devolución se hace en «Vender» → «Ventas y devoluciones», desde el
                        ticket original, para que quede vinculada. Aquí solo se enlaza.
                    </div>
                </group>
                <group string="Cobro mal anotado" invisible="correction_type != 'payment_method'">
                    <field name="original_payment_id" required="correction_type == 'payment_method'"/>
                    <field name="corrected_method_id" required="correction_type == 'payment_method'"/>
                    <field name="amount" required="correction_type == 'payment_method'"/>
                    <div class="text-muted" colspan="2">
                        El cobro original se conserva tal cual: se registra su reclasificación.
                        Si la caja sigue abierta y el cambio entra o sale de efectivo, se ajusta
                        también el efectivo esperado. Si la caja ya está cerrada, su cierre no se
                        toca: la reclasificación queda aparte, para conciliarla.
                    </div>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Registrar corrección"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mgs_corrections" model="ir.actions.act_window">
        <field name="name">Correcciones</field>
        <field name="res_model">mgs.correction</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mgs_correction_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay correcciones</p>
            <p>
                Aquí queda el historial de los errores corregidos: qué operación se corrigió,
                por qué, quién lo confirmó y en qué acabó. No se puede modificar ni borrar.
            </p>
        </field>
    </record>

    <record id="action_mgs_correction_wizard" model="ir.actions.act_window">
        <field name="name">Registrar una corrección</field>
        <field name="res_model">mgs.correction.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_mgs_correction_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
