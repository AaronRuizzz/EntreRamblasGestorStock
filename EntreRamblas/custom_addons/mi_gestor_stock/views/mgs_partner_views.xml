<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Informes → Clientes: "un sitio donde consultar los clientes, y
         con ellos, sus facturas" (petición de la propietaria). No es la
         ficha de contacto completa de Odoo (esa sigue sin menú, ver
         data/ux_defaults.xml): es una pantalla propia, de solo consulta
         más lo justo para completar una factura (plazo de pago, día de
         vencimiento), sobre res.partner/account.move nativos.

         Solo clientes reales (customer_rank > 0): ese contador solo sube
         al cerrar una sesión de caja con ventas suyas o al confirmar una
         factura (point_of_sale/models/pos_session.py,
         account/models/account_move.py) — no aparecen aquí fichas creadas
         sin haber comprado nunca.
         ============================================================ -->
    <record id="view_mgs_partner_list" model="ir.ui.view">
        <field name="name">res.partner.list.mgs</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Clientes" create="0" delete="0" default_order="name">
                <field name="name"/>
                <field name="vat" string="NIF"/>
                <field name="phone"/>
                <field name="property_payment_term_id" string="Forma de pago"/>
                <field name="total_invoiced" string="Total facturado" widget="monetary"/>
                <field name="credit" string="Pendiente de cobro" widget="monetary"/>
            </list>
        </field>
    </record>

    <record id="view_mgs_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.mgs</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Cliente" create="0" delete="0" js_class="mgs_clean_form">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="vat" string="NIF"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="street"/>
                            <field name="zip"/>
                            <field name="city"/>
                            <field name="country_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="property_payment_term_id" string="Forma de pago"/>
                        </group>
                        <group>
                            <field name="total_invoiced" string="Total facturado" widget="monetary"/>
                            <field name="credit" string="Pendiente de cobro" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- Editable en la propia lista (plazo de pago y
                             vencimiento) para no depender de a qué formulario
                             de account.move resolvería Odoo al abrir la
                             factura desde aquí — ese formulario es el
                             complejo del módulo de Contabilidad, que esta
                             tienda no usa. Solo se puede tocar mientras la
                             factura siga en borrador; una vez contabilizada
                             (el camino normal: el TPV la contabiliza al
                             cobrar) las reglas propias de account.move ya
                             impiden tocar sus asientos. -->
                        <page string="Facturas" name="mgs_invoices">
                            <field name="invoice_ids"
                                   domain="[('move_type', 'in', ('out_invoice', 'out_refund', 'out_receipt'))]">
                                <list create="0" delete="0" editable="bottom"
                                      default_order="invoice_date desc"
                                      decoration-muted="state == 'cancel'">
                                    <field name="name" string="Factura" readonly="1"/>
                                    <field name="invoice_date" string="Fecha" readonly="1"/>
                                    <field name="invoice_payment_term_id" string="Plazo de pago"
                                           readonly="state != 'draft'"/>
                                    <field name="invoice_date_due" string="Vencimiento"
                                           readonly="state != 'draft'"/>
                                    <field name="amount_total" string="Importe" widget="monetary" readonly="1"/>
                                    <field name="payment_state" string="Cobro" widget="badge" readonly="1"/>
                                    <field name="state" widget="badge" readonly="1"
                                           decoration-success="state == 'posted'"
                                           decoration-danger="state == 'cancel'"/>
                                    <button name="action_mgs_invoice_pdf" type="object"
                                            string="Ver PDF" icon="fa-file-pdf-o"
                                            invisible="state != 'posted'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mgs_report_clients" model="ir.actions.act_window">
        <field name="name">Clientes</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('customer_rank', '&gt;', 0)]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_mgs_partner_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_mgs_partner_form')})]"/>
    </record>

</odoo>
