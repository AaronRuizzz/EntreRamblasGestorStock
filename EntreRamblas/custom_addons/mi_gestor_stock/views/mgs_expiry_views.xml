<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mgs_expiry_writeoff_list" model="ir.ui.view">
        <field name="name">mgs.expiry.writeoff.list</field>
        <field name="model">mgs.expiry.writeoff</field>
        <field name="arch" type="xml">
            <list string="Bajas de caducados" default_order="detected_at desc">
                <field name="name"/>
                <field name="detected_at"/>
                <field name="total_cost" sum="Coste"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'proposed'"
                       decoration-success="state == 'confirmed'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_mgs_expiry_writeoff_form" model="ir.ui.view">
        <field name="name">mgs.expiry.writeoff.form</field>
        <field name="model">mgs.expiry.writeoff</field>
        <field name="arch" type="xml">
            <form string="Baja de caducados" js_class="mgs_clean_form" create="false">
                <header>
                    <button name="action_confirm" string="Dar de baja" type="object"
                            class="btn-primary" invisible="state != 'proposed'"
                            confirm="Esto da de baja las partidas de la lista. No se puede deshacer: se corrige con un recuento físico."/>
                    <button name="action_cancel" string="Descartar propuesta" type="object"
                            invisible="state != 'proposed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <field name="detected_at"/>
                        <field name="total_cost" widget="monetary"/>
                        <field name="confirmed_at" invisible="not confirmed_at"/>
                        <field name="confirmed_by" invisible="not confirmed_by"/>
                    </group>
                    <field name="line_ids" readonly="1">
                        <list>
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="location_id"/>
                            <field name="quantity"/>
                            <field name="unit_cost"/>
                            <field name="subtotal"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mgs_expiry_writeoffs" model="ir.actions.act_window">
        <field name="name">Bajas de caducados</field>
        <field name="res_model">mgs.expiry.writeoff</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay ninguna propuesta.</p>
            <p>El programa revisa cada día si hay algo caducado más allá del margen
               configurado y prepara aquí una propuesta para revisarla antes de confirmar.</p>
        </field>
    </record>
</odoo>
