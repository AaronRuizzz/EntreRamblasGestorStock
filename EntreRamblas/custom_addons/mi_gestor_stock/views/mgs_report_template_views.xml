<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Informes personalizados: plantillas reutilizables.

         «Gestoría completa» sale siempre arriba (_order la pone primero) y
         con sus filtros y secciones en gris: el candado de verdad está en
         models/mgs_report_template.py -> write(); esto solo evita que la
         propietaria pierda el tiempo intentando cambiarlos.
         ============================================================ -->
    <record id="view_mgs_report_template_list" model="ir.ui.view">
        <field name="name">mgs.report.template.list</field>
        <field name="model">mgs.report.template</field>
        <field name="arch" type="xml">
            <list string="Informes personalizados">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="is_locked" string="Para gestoría" widget="boolean_toggle" readonly="1"/>
                <field name="preview_generated_at" string="Vista previa"/>
                <field name="preview_stale" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_mgs_report_template_search" model="ir.ui.view">
        <field name="name">mgs.report.template.search</field>
        <field name="model">mgs.report.template</field>
        <field name="arch" type="xml">
            <search string="Informes personalizados">
                <field name="name"/>
                <filter name="filter_gestoria" string="Para gestoría"
                        domain="[('is_locked', '=', True)]"/>
                <filter name="filter_custom" string="Mías"
                        domain="[('is_locked', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_mgs_report_template_form" model="ir.ui.view">
        <field name="name">mgs.report.template.form</field>
        <field name="model">mgs.report.template</field>
        <field name="arch" type="xml">
            <form string="Informe personalizado" js_class="mgs_clean_form">
                <header>
                    <button name="action_refresh_preview" type="object" string="Actualizar vista previa"
                            class="btn-primary"/>
                    <button name="action_export_excel" type="object" string="Exportar a Excel"/>
                    <button name="action_print" type="object" string="Generar PDF"/>
                </header>
                <sheet>
                    <div class="alert alert-success" role="status" invisible="not is_gestoria_master">
                        <strong>Informe para gestoría.</strong>
                        Incluye las operaciones no clasificadas del periodo.
                        No se le pueden añadir filtros ni quitar secciones: solo se cambia el periodo.
                    </div>
                    <div class="alert alert-warning" role="status" invisible="is_gestoria_master">
                        <strong>Informe parcial para análisis interno.</strong>
                        Cualquier informe que no sea «Gestoría completa» se marca como parcial,
                        aunque no lleve ningún filtro puesto: para la gestoría se usa la plantilla completa.
                    </div>
                    <div class="alert alert-info" role="status" invisible="not preview_stale">
                        La vista previa no está al día. Pulsa «Actualizar vista previa» para recalcularla.
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="is_locked"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="group_by" readonly="is_locked"/>
                            <field name="order_by" readonly="is_locked"/>
                            <field name="preview_generated_at"/>
                            <field name="is_locked" invisible="1"/>
                            <field name="is_gestoria_master" invisible="1"/>
                            <field name="preview_stale" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Secciones" name="sections">
                            <group>
                                <group string="Dinero">
                                    <field name="section_resumen" readonly="is_locked"/>
                                    <field name="section_ventas" readonly="is_locked"/>
                                    <field name="section_devoluciones" readonly="is_locked"/>
                                    <field name="section_cobros" readonly="is_locked"/>
                                    <field name="section_correcciones" readonly="is_locked"/>
                                </group>
                                <group string="Mercancía">
                                    <field name="section_mermas" readonly="is_locked"/>
                                    <field name="section_stock" readonly="is_locked"/>
                                    <field name="section_consumo" readonly="is_locked"/>
                                    <field name="section_eventos" readonly="is_locked"/>
                                </group>
                            </group>
                        </page>
                        <page string="Filtros" name="filters">
                            <group>
                                <field name="category_ids" widget="many2many_tags" readonly="is_locked"/>
                                <field name="product_ids" widget="many2many_tags" readonly="is_locked"/>
                                <field name="payment_method_ids" widget="many2many_tags" readonly="is_locked"/>
                            </group>
                            <p class="text-muted">
                                Los cobros se prorratean por el importe incluido de cada ticket. Esto
                                conserva correctamente los pagos mixtos cuando se filtra por producto,
                                categoría o se excluyen líneas en la preparación del informe.
                            </p>
                        </page>
                        <page string="Preparar ventas" name="prepare_sales">
                            <p class="text-muted">
                                Pulsa «Actualizar vista previa» para cargar las líneas del periodo.
                                «En B» se guarda globalmente para esa línea y se aplicará en todos los
                                informes. Las devoluciones vinculadas heredan su estado automáticamente.
                            </p>
                            <field name="review_line_ids" readonly="1">
                                <list string="Líneas vendidas" create="0" edit="0" delete="0">
                                    <field name="date_order"/>
                                    <field name="order_id"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="amount"/>
                                    <field name="excluded" widget="boolean_toggle"/>
                                    <button name="action_mark_excluded" type="object" string="Marcar en B"
                                            class="btn-primary" invisible="excluded"/>
                                    <button name="action_mark_included" type="object" string="Volver a incluir"
                                            invisible="not excluded"/>
                                </list>
                            </field>
                        </page>
                        <page string="Vista previa" name="preview">
                            <group>
                                <group string="Ventas y cobros">
                                    <field name="preview_sales_count"/>
                                    <field name="preview_sales_total"/>
                                    <field name="preview_refunds_count"/>
                                    <field name="preview_refunds_total"/>
                                    <field name="preview_payments_net"/>
                                    <field name="preview_corrections_count"/>
                                </group>
                                <group string="Mercancía">
                                    <field name="preview_scrap_cost"/>
                                    <field name="preview_stock_value"/>
                                    <field name="preview_consumption_cost"/>
                                    <field name="preview_events_count"/>
                                </group>
                            </group>
                            <field name="preview_line_ids" readonly="1">
                                <list string="Vista previa" create="0" edit="0" delete="0">
                                    <field name="section"/>
                                    <field name="date"/>
                                    <field name="label"/>
                                    <field name="qty"/>
                                    <field name="amount"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mgs_report_templates" model="ir.actions.act_window">
        <field name="name">Informes personalizados</field>
        <field name="res_model">mgs.report.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mgs_report_template_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea tu primer informe personalizado</p>
            <p>
                Elige el periodo, las secciones y los filtros, mira la vista previa y
                expórtalo a Excel o PDF. Para la gestoría, usa la plantilla
                «Gestoría completa», sin filtros manuales.
            </p>
        </field>
    </record>
</odoo>
