<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mgs_report_exclusion_wizard_form" model="ir.ui.view">
        <field name="name">mgs.report.exclusion.wizard.form</field>
        <field name="model">mgs.report.exclusion.wizard</field>
        <field name="arch" type="xml">
            <form string="Clasificar líneas">
                <sheet>
                    <p class="text-muted">El cambio solo afecta a los informes. No modifica el ticket, el cobro ni el stock.</p>
                    <group>
                        <field name="review_ids" widget="many2many_tags" readonly="1"/>
                        <field name="excluded"/>
                        <field name="reason" placeholder="Explica por qué se cambia la clasificación..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_mgs_report_exclusion_log_list" model="ir.ui.view">
        <field name="name">mgs.report.exclusion.log.list</field>
        <field name="model">mgs.report.exclusion.log</field>
        <field name="arch" type="xml">
            <list string="Historial de líneas clasificadas" create="0" edit="0" delete="0">
                <field name="changed_at"/><field name="order_id"/><field name="line_id"/>
                <field name="was_excluded"/><field name="is_excluded"/><field name="reason"/>
                <field name="user_id" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <record id="view_mgs_report_exclusion_log_form" model="ir.ui.view">
        <field name="name">mgs.report.exclusion.log.form</field>
        <field name="model">mgs.report.exclusion.log</field>
        <field name="arch" type="xml">
            <form string="Cambio de clasificación" create="0" edit="0" delete="0"><sheet><group>
                <field name="changed_at"/><field name="user_id"/><field name="order_id"/>
                <field name="line_id"/><field name="was_excluded"/><field name="is_excluded"/><field name="reason"/>
            </group></sheet></form>
        </field>
    </record>

    <record id="action_mgs_report_exclusion_log" model="ir.actions.act_window">
        <field name="name">Historial de líneas clasificadas</field>
        <field name="res_model">mgs.report.exclusion.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
