<odoo>
    <record id="catalog_import_form" model="ir.ui.view">
        <field name="name">mgs.catalog.import.form</field>
        <field name="model">mgs.catalog.import</field>
        <field name="arch" type="xml">
            <form string="Alta de catálogo">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <p><b>Paso 1.</b> Descarga la plantilla y rellena una fila por producto.
                            El <b>código</b> puede quedarse vacío: el programa genera uno interno
                            y luego imprimes la etiqueta.</p>
                        <p><b>Paso 2.</b> Sube la hoja y pulsa <b>Comprobar hoja</b>. No se crea nada
                            hasta que todas las filas estén correctas.</p>
                        <p><b>Paso 3.</b> Importa. Las <b>existencias</b> no entran aquí: se registran
                            después en <b>Stock → Existencias iniciales</b>.</p>
                    </div>
                    <group>
                        <group>
                            <field name="file" filename="filename" readonly="state == 'done'"/>
                            <field name="filename" invisible="1"/>
                            <field name="state" readonly="1"/>
                        </group>
                        <group>
                            <field name="allow_zero_prices" readonly="state == 'done'"/>
                            <field name="allow_new_categories" readonly="state == 'done'"/>
                            <field name="error_count" readonly="1"/>
                        </group>
                    </group>
                    <field name="summary" readonly="1" nolabel="1"
                           invisible="not summary" widget="text"/>
                    <field name="line_ids" readonly="1" invisible="not line_ids">
                        <!-- La comprobación va justo detrás del nombre: es lo que hay
                             que leer para corregir la hoja, no puede quedar fuera de
                             la pantalla detrás de las columnas de datos. -->
                        <list decoration-danger="has_error" decoration-success="product_id">
                            <field name="row_number"/>
                            <field name="name"/>
                            <field name="message" width="320"/>
                            <field name="price"/>
                            <field name="cost"/>
                            <field name="vat"/>
                            <field name="code"/>
                            <field name="category_name" optional="hide"/>
                            <field name="uom_id" optional="hide"/>
                            <field name="product_id" optional="show"/>
                            <field name="has_error" column_invisible="1"/>
                        </list>
                    </field>
                    <field name="template_file" filename="template_filename" invisible="1"/>
                    <field name="template_filename" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_check" type="object" string="Comprobar hoja"
                            class="btn-primary" invisible="state == 'done'"/>
                    <button name="action_apply" type="object" string="Importar catálogo"
                            class="btn-primary" invisible="state != 'checked'"
                            confirm="Se van a crear las fichas de producto de la hoja. Las existencias se registran después en Existencias iniciales."/>
                    <button name="action_download_template" type="object"
                            string="Descargar plantilla" class="btn-secondary"/>
                    <button name="action_open_products" type="object" string="Ver catálogo"
                            class="btn-secondary" invisible="state != 'done'"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_catalog_import" model="ir.actions.act_window">
        <field name="name">Alta de catálogo</field>
        <field name="res_model">mgs.catalog.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
