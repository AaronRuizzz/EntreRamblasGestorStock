<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Personalizacion de la pantalla de inicio de sesion.
         Hereda las plantillas QWeb del modulo `web` sin tocarlas.
         Originales: odoo/addons/web/views/webclient_templates.xml
           - web.login_layout  (tarjeta, logo, pie)
           - web.login         (formulario email / password)
         ============================================================ -->

    <template id="mgs_login_layout" inherit_id="web.login_layout">
        <!-- Fondo a pantalla completa: clase en el <body> -->
        <xpath expr="//t[@t-set='body_classname']" position="replace">
            <t t-set="body_classname" t-value="'bg-100 o_mgs_login_body'"/>
        </xpath>
        <!-- Centrado vertical -->
        <xpath expr="//div[hasclass('container')]" position="attributes">
            <attribute name="class" add="o_mgs_login_bg" separator=" "/>
        </xpath>
        <!-- Clase propia en la tarjeta (usa t-attf-class) -->
        <xpath expr="//div[hasclass('card-body')]/parent::div" position="attributes">
            <attribute name="t-attf-class" add="o_mgs_login_card" separator=" "/>
        </xpath>
        <!-- Nuestro emblema en lugar de "Your logo" -->
        <xpath expr="//div[hasclass('border-bottom')]/img" position="attributes">
            <attribute name="t-attf-src">/mi_gestor_stock/static/src/img/logo-emblema.png</attribute>
            <attribute name="alt">Entre Ramblas · Clavel &amp; Azahar</attribute>
            <attribute name="style"/>
        </xpath>
    </template>

    <template id="mgs_login" inherit_id="web.login">
        <!-- Quita el selector "Elija un usuario": aqui solo entra la
             propietaria, no interesa el listado de ultimos usuarios. -->
        <xpath expr="//owl-component[@name='web.user_switch']" position="replace"/>
        <!-- El formulario ya no lo destapa el componente user_switch:
             hay que quitarle la clase d-none para que se vea siempre.
             (usa t-attf-class dinamico, por eso no vale hasclass()) -->
        <xpath expr="//form" position="attributes">
            <attribute name="t-attf-class">oe_login_form</attribute>
        </xpath>

        <xpath expr="//form" position="before">
            <!-- Titulo de la pestana del navegador -->
            <t t-set="title">Gestión de stock</t>
            <!-- Favicon de la pagina de login -->
            <t t-set="x_icon">/mi_gestor_stock/static/src/img/favicon.png</t>
            <!-- Oculta el pie con "Manage Databases" y "Powered by Odoo" -->
            <t t-set="disable_footer" t-value="True"/>
            <!-- Modo estricto: la dueña ya fijo su contrasena, asi que el
                 servidor autentica SIEMPRE su cuenta y el formulario no
                 muestra el campo de usuario. Antes de configurarla (o en la
                 base de validacion, sin propietaria) el campo sigue visible
                 para poder entrar con otra cuenta. -->
            <t t-set="mgs_strict"
               t-value="bool(request.env['res.users'].sudo()._mgs_owner().mgs_password_set)"/>

            <div class="o_mgs_login_title text-center mb-3">
                <small class="text-muted">Gestor de stock y punto de venta</small>
            </div>
        </xpath>

        <!-- Campo de usuario: solo cuando NO hay propietaria configurada. -->
        <xpath expr="//div[hasclass('field-login')]" position="replace">
            <div class="mb-3 field-login" t-if="not mgs_strict">
                <label for="login" class="form-label">Usuario</label>
                <input type="text" placeholder="Usuario" name="login" t-att-value="login" id="login"
                       class="form-control" required="required" autocapitalize="off" autocomplete="username"/>
            </div>
        </xpath>

        <!-- Boton: «Entrar», no «Log in». -->
        <xpath expr="//div[hasclass('oe_login_buttons')]/button[@type='submit']" position="replace">
            <button type="submit" class="btn btn-primary">Entrar</button>
        </xpath>

        <!-- Mostrar la contrasena temporalmente. -->
        <xpath expr="//div[hasclass('oe_login_buttons')]" position="before">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="mgs_show_login_pw"
                       data-mgs-toggle-password="password"/>
                <label class="form-check-label small" for="mgs_show_login_pw">Mostrar la contraseña</label>
            </div>
        </xpath>

        <!-- Recuperacion sin correo: la clave impresa. -->
        <xpath expr="//div[hasclass('oe_login_buttons')]" position="after">
            <div class="text-center mt-2">
                <a href="/mgs/recuperar" class="btn btn-link btn-sm">He olvidado mi contraseña</a>
            </div>
        </xpath>

        <!-- Sin pie de marca: el emblema ya lleva el nombre de la floristeria,
             repetirlo abajo sobraba. Se deja solo una linea de cierre. -->
        <xpath expr="//form" position="after">
            <div class="o_mgs_login_foot mt-3"/>
        </xpath>
    </template>

</odoo>
