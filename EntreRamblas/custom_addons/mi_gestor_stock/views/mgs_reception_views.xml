<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mgs_reception_form" model="ir.ui.view">
        <field name="name">mgs.reception.form</field>
        <field name="model">mgs.reception</field>
        <field name="arch" type="xml">
            <!-- js_class + create/duplicate/delete a false: esta pantalla es un
                 flujo de trabajo, no una ficha. Fuera "Nuevo", la rueda de
                 ajustes y el guardar/descartar genéricos; los únicos botones
                 son los de la cabecera. -->
            <form string="Recepción" js_class="mgs_clean_form"
                  create="false" duplicate="false" delete="false">
                <!-- Engancha el lector: barcodes.barcode_events_mixin recibe
                     aquí cualquier escaneo hecho en toda la pantalla, tenga
                     o no el foco puesto en un campo. No marcar invisible. -->
                <field name="_barcode_scanned" widget="barcode_handler"/>
                <field name="company_id" invisible="1"/>
                <header>
                    <button name="action_confirm" string="Guardar en almacén" type="object"
                            class="btn-primary" invisible="not line_ids"/>
                    <!-- Etiquetas en la térmica de 80 mm: la impresora dibuja
                         el código de barras (ESC/POS), no hace falta PDF. -->
                    <button name="action_mgs_print_labels" string="Imprimir etiquetas"
                            type="object" invisible="not line_ids"/>
                    <button name="action_clear" string="Vaciar" type="object"
                            invisible="not line_ids"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="supplier_id"/>
                            <field name="supplier_ref" placeholder="Nº de albarán del proveedor"/>
                        </group>
                        <group>
                            <field name="document_date" class="mgs-date-input"/>
                            <field name="picking_id" invisible="not picking_id"/>
                        </group>
                    </group>
                    <div class="mgs-mode-switch">
                        <field name="mode" widget="radio" options="{'horizontal': true}"
                               nolabel="1"/>
                    </div>

                    <!-- ============ MODO: PRODUCTO EXISTENTE ============ -->
                    <div class="mgs-scan-box" invisible="mode != 'existente'">
                        <field name="manual_barcode" nolabel="1" class="mgs-scan-input"
                               placeholder="Escanea el código de barras del producto…"/>
                        <div class="mgs-scan-hint">
                            El producto ya está dado de alta: se reutiliza toda su
                            información. Cada recepción conserva su propia partida,
                            coste y caducidad.
                        </div>
                    </div>

                    <!-- ============ MODO: PRODUCTO NUEVO ============ -->
                    <div class="mgs-new-box" invisible="mode != 'nuevo'">
                        <field name="currency_id" invisible="1"/>
                        <group>
                            <!-- Columna izquierda: qué es el producto. -->
                            <group string="Información del producto">
                                <field name="new_name" placeholder="Ej. Rosa roja de tallo largo"/>
                                <!-- El selector estándar deja escoger una categoría ya
                                     creada y también ofrece «Crear» cuando hace falta. -->
                                <field name="new_categ_id"
                                       required="mode == 'nuevo'"
                                       placeholder="Elige o crea una categoría…"/>
                                <field name="new_expiry_date" class="mgs-date-input"/>
                                <!-- Alquiler para eventos: sale y vuelve (models/mgs_event.py). -->
                                <field name="new_rental_ok" string="Se alquila para eventos"/>
                                <field name="new_rental_deposit" string="Fianza por unidad"
                                       class="mgs-price-field" widget="monetary"
                                       options="{'currency_field': 'currency_id', 'field_digits': True}"
                                       invisible="not new_rental_ok"/>
                            </group>
                            <!-- Columna derecha: la calculadora de margen — a partir del
                                 coste y de un margen (10/20/30/40/60 % u «Otro»), el precio
                                 de venta sin IVA se calcula solo; con el IVA se llega al
                                 precio de venta. Escribir el precio a mano también funciona,
                                 en sentido inverso: recalcula qué margen representa. -->
                            <group string="Precio y margen">
                                <field name="new_cost" string="Precio de coste" class="mgs-price-field"
                                       widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                                <field name="new_margin_preset" widget="radio"
                                       options="{'horizontal': true}"/>
                                <field name="new_margin" string="Margen (%)"
                                       invisible="new_margin_preset != 'otro'"/>
                                <field name="new_price" string="Precio de venta sin IVA"
                                       class="mgs-price-field" widget="monetary"
                                       options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                                <field name="new_margin_amount" string="Beneficio" class="mgs-price-field"
                                       widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                                <field name="new_markup_hint" nolabel="1"
                                       invisible="not new_markup_hint"/>
                                <!-- La lista se limita aquí también (además de en el
                                     modelo) para que el selector del navegador nunca
                                     cargue los impuestos técnicos de la localización.
                                     «Crear y editar…» sigue disponible para añadir un
                                     tipo nuevo cuando lo indique la gestoría. -->
                                <field name="new_tax_id" placeholder="Elige IVA…"
                                       domain="[('type_tax_use', '=', 'sale'), ('company_id', '=', company_id), ('amount_type', '=', 'percent'), ('amount', 'in', [0, 21])]"
                                       context="{'default_type_tax_use': 'sale', 'default_company_id': company_id}"
                                       options="{'no_create': False, 'no_create_edit': False}"/>
                                <field name="new_price_taxed" string="Precio de venta" class="mgs-price-field"
                                       widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                            </group>
                        </group>
                        <group string="Código de barras">
                            <field name="new_barcode" nolabel="1" class="mgs-scan-input"
                                   placeholder="Escanea el código para asignarlo…"/>
                            <!-- Flores a granel, envoltorios o composiciones
                                 propias no traen EAN: se les genera uno
                                 interno y se imprime en una etiqueta. -->
                            <button name="action_mgs_generate_barcode" type="object"
                                    string="Generar código interno"
                                    class="btn-link ps-0" colspan="2"/>
                        </group>
                        <div class="mgs-new-actions">
                            <button name="action_add_new_product" type="object"
                                    string="Crear y añadir a la recepción"
                                    class="btn-primary"/>
                        </div>
                    </div>

                    <field name="scan_message" readonly="1" nolabel="1"
                           class="mgs-scan-feedback" invisible="not scan_message"/>

                    <!-- create="false": la única forma de meter un producto en la
                         lista es escaneando (existente) o dándolo de alta arriba
                         (nuevo). Sin "Añadir línea" no se puede elegir a mano un
                         producto ya creado. -->
                    <field name="line_ids">
                        <list editable="bottom" create="false">
                            <field name="product_id" readonly="1"/>
                            <field name="barcode" readonly="1" optional="show"/>
                            <field name="qty_available" readonly="1" string="Stock actual"/>
                            <field name="quantity"/>
                            <field name="uom_id"/>
                            <field name="unit_cost"/>
                            <field name="expiry_date" class="mgs-date-input"/>
                            <!-- Qué sale de la recepción es alquiler y qué no,
                                 de un vistazo, sin abrir cada ficha. -->
                            <field name="rental_ok" widget="boolean_toggle" readonly="1"/>
                            <button name="action_mgs_print_label" type="object"
                                    icon="fa-print" title="Imprimir etiqueta"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mgs_reception" model="ir.actions.act_window">
        <field name="name">Recepción</field>
        <field name="res_model">mgs.reception</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_mgs_reception_form"/>
        <field name="target">current</field>
    </record>
</odoo>
