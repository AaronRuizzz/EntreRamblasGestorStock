<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mgs_scrap_form" model="ir.ui.view">
        <field name="name">stock.scrap.form.mgs</field>
        <field name="model">stock.scrap</field>
        <field name="arch" type="xml">
            <form string="Merma" js_class="mgs_clean_form">
                <header>
                    <button name="do_scrap" type="object" string="Registrar merma" class="btn-primary" invisible="state == 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="product_id" readonly="state == 'done'"/>
                        <field name="lot_id" readonly="state == 'done'" options="{'no_create': True}"/>
                        <field name="scrap_qty" readonly="state == 'done'"/>
                        <field name="product_uom_id" readonly="1"/>
                        <field name="mgs_reason" readonly="state == 'done'"/>
                        <field name="origin" readonly="state == 'done'"/>
                        <field name="mgs_return_line_id" invisible="not mgs_return_line_id"/>
                        <field name="location_id" readonly="state == 'done'" options="{'no_create': True}"/>
                        <field name="company_id" invisible="1"/>
                        <field name="mgs_validated_by" invisible="state != 'done'"/>
                        <field name="date_done" invisible="state != 'done'"/>
                    </group>
                </sheet>
                <!-- Sin chatter a propósito: aquí trabajan la dueña y la
                     dependienta, no un equipo que necesite mensajes ni
                     seguidores. Quién dio de baja y cuándo ya están arriba
                     como campos (mgs_validated_by, date_done), y la merma
                     es inmutable en cuanto queda hecha. -->
            </form>
        </field>
    </record>
    <record id="view_mgs_scrap_list" model="ir.ui.view">
        <field name="name">stock.scrap.list.mgs</field>
        <field name="model">stock.scrap</field>
        <field name="arch" type="xml">
            <list string="Mermas">
                <field name="date_done"/><field name="product_id"/><field name="lot_id"/>
                <field name="scrap_qty"/><field name="mgs_reason"/><field name="mgs_validated_by"/><field name="state"/>
            </list>
        </field>
    </record>
    <!-- Buscador propio: el nativo (stock.stock_scrap_search_view) filtra y
         agrupa por Ubicación / Ubicación de desecho / Transferencia, que en
         una sola tienda con una sola ubicación de mermas no dice nada. -->
    <record id="view_mgs_scrap_search" model="ir.ui.view">
        <field name="name">stock.scrap.search.mgs</field>
        <field name="model">stock.scrap</field>
        <field name="arch" type="xml">
            <search string="Mermas">
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="mgs_reason"/>
                <filter name="filter_date" date="date_done" string="Fecha"/>
                <group expand="1" string="Agrupar por">
                    <filter string="Producto" name="group_product" context="{'group_by':'product_id'}"/>
                    <filter string="Motivo" name="group_reason" context="{'group_by':'mgs_reason'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_mgs_scrap" model="ir.actions.act_window">
        <field name="name">Mermas</field>
        <field name="res_model">stock.scrap</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mgs_scrap_search"/>
        <field name="view_ids" eval="[(5,0,0),(0,0,{'view_mode':'list','view_id':ref('view_mgs_scrap_list')}),(0,0,{'view_mode':'form','view_id':ref('view_mgs_scrap_form')})]"/>
    </record>
</odoo>
