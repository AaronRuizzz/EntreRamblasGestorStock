<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mgs_pricelist_campaign_form" model="ir.ui.view">
        <field name="name">mgs.pricelist.campaign.form</field>
        <field name="model">mgs.pricelist.campaign</field>
        <field name="arch" type="xml">
            <form string="Tarifa de campaña">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ej. San Valentín 2027"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="categ_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="compute_price" widget="radio"/>
                            <field name="percent_price" invisible="compute_price != 'discount'"/>
                            <field name="fixed_price" invisible="compute_price != 'fixed'"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create" string="Crear tarifa" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mgs_pricelist_campaign" model="ir.actions.act_window">
        <field name="name">Tarifa de campaña</field>
        <field name="res_model">mgs.pricelist.campaign</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Ver/editar/desactivar las tarifas ya creadas. La lista es propia,
         solo para meter el botón de cabecera que abre el asistente — antes
         era un menú aparte ("Nueva tarifa de campaña"); el formulario que se
         abre al hacer clic en una fila es el nativo de product.pricelist,
         sin redefinir nada: ya es sencillo tal cual. -->
    <record id="view_mgs_pricelist_list" model="ir.ui.view">
        <field name="name">product.pricelist.list.mgs</field>
        <field name="model">product.pricelist</field>
        <field name="arch" type="xml">
            <list string="Tarifas de campaña">
                <header>
                    <button name="%(action_mgs_pricelist_campaign)d" type="action"
                            string="Nueva tarifa de campaña" class="btn-primary"/>
                </header>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Ficha propia: la nativa (product.product_pricelist_view) trae grupos
         de países, moneda multiempresa y las reglas en crudo (editables,
         con sus cuatro modos de cálculo). Aquí solo se consulta: crear una
         tarifa sigue siendo cosa del asistente. -->
    <record id="view_mgs_pricelist_form" model="ir.ui.view">
        <field name="name">product.pricelist.form.mgs</field>
        <field name="model">product.pricelist</field>
        <field name="arch" type="xml">
            <form string="Tarifa de campaña" create="0" js_class="mgs_clean_form">
                <sheet>
                    <widget name="web_ribbon" title="Archivada" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <field name="active" readonly="1"/>
                    <field name="item_ids" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="name" string="A qué se aplica y precio"/>
                            <field name="date_start" string="Desde"/>
                            <field name="date_end" string="Hasta"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mgs_pricelists" model="ir.actions.act_window">
        <field name="name">Tarifas de campaña</field>
        <field name="res_model">product.pricelist</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'sequence': 1, 'view_mode': 'list', 'view_id': ref('view_mgs_pricelist_list')}),
            (0, 0, {'sequence': 2, 'view_mode': 'form', 'view_id': ref('view_mgs_pricelist_form')})]"/>
    </record>
</odoo>
