<odoo>
    <record id="opening_company_rule" model="ir.rule">
        <field name="name">Aperturas por compañía</field><field name="model_id" ref="model_mgs_opening_stock"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="opening_line_company_rule" model="ir.rule">
        <field name="name">Partidas iniciales por compañía</field><field name="model_id" ref="model_mgs_opening_stock_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="opening_form" model="ir.ui.view">
        <field name="name">mgs.opening.stock.form</field><field name="model">mgs.opening.stock</field>
        <field name="arch" type="xml">
            <form string="Existencias iniciales" duplicate="false" js_class="mgs_clean_form">
                <header><button name="action_apply" type="object" string="Aplicar apertura" class="btn-primary" invisible="state == 'done'" confirm="Se registrarán estas existencias iniciales. Comprueba cantidades y costes antes de continuar."/><field name="state" widget="statusbar"/></header>
                <sheet>
                    <p>Solo para productos sin existencias ni movimientos anteriores. Cada línea genera una partida. Las compras posteriores se registran en Recepción.</p>
                    <group><field name="name" readonly="state == 'done'"/><field name="company_id" invisible="1"/><field name="location_id" readonly="state == 'done'"/><field name="applied_by" invisible="state != 'done'"/><field name="applied_at" invisible="state != 'done'"/></group>
                    <field name="line_ids" readonly="state == 'done'">
                        <list editable="bottom"><field name="product_id" domain="[('is_storable', '=', True), ('mgs_auto_lots', '=', True)]"/><field name="quantity"/><field name="unit_cost"/><field name="expiry_date"/><field name="checked"/><field name="lot_id" optional="show"/><field name="move_id" optional="hide"/></list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="opening_list" model="ir.ui.view">
        <field name="name">mgs.opening.stock.list</field><field name="model">mgs.opening.stock</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="location_id"/><field name="state"/><field name="applied_at"/><field name="applied_by"/></list></field>
    </record>
    <record id="action_opening_stock" model="ir.actions.act_window"><field name="name">Existencias iniciales</field><field name="res_model">mgs.opening.stock</field><field name="view_mode">list,form</field></record>
</odoo>
