<?xml version="1.0" encoding="UTF-8"?>
<!-- Quita el envío de ticket por email/SMS de la pantalla de cobro
     completado: la tienda no usa esa función. Los botones de imprimir
     (arriba) y "New Order" (abajo) no se tocan: siguen siendo el flujo
     real de cierre de venta. -->
<templates id="template" xml:space="preserve">
    <t t-name="mi_gestor_stock.ReceiptScreenNoEmail" t-inherit="point_of_sale.ReceiptScreen"
       t-inherit-mode="extension">
        <xpath expr="//div[@class='receipt-options d-flex flex-column gap-2']/div[@class='d-flex flex-column gap-2']"
               position="replace"/>
        <xpath expr="//div[@class='notice text-center']" position="replace"/>
    </t>
</templates>
