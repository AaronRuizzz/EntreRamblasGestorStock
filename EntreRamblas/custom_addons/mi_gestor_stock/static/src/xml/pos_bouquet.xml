<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="mi_gestor_stock.BouquetPopup">
        <Dialog title="props.product.display_name" size="'lg'">
            <div class="d-flex flex-column flex-lg-row gap-3" style="min-height: 22rem;">

                <!-- Izquierda: lo que se puede meter en el ramo -->
                <div class="d-flex flex-column flex-grow-1" style="flex-basis: 55%;">
                    <input type="text" class="form-control form-control-lg mb-2"
                           placeholder="Buscar flor o material..."
                           t-model="state.search"/>
                    <div class="overflow-auto border rounded" style="max-height: 20rem;">
                        <t t-if="!candidates.length">
                            <div class="p-3 text-muted">No hay material que coincida con la búsqueda.</div>
                        </t>
                        <button t-foreach="candidates" t-as="item" t-key="item.id"
                                class="btn btn-light w-100 text-start border-bottom rounded-0 py-2"
                                t-on-click="() => this.add(item)">
                            <span t-esc="item.display_name"/>
                            <span class="float-end text-muted">
                                <t t-esc="item.lst_price"/> <t t-esc="props.currency"/>
                            </span>
                        </button>
                    </div>
                </div>

                <!-- Derecha: lo que lleva el ramo -->
                <div class="d-flex flex-column flex-grow-1" style="flex-basis: 45%;">
                    <h6 class="mb-2">Lleva</h6>
                    <div class="overflow-auto flex-grow-1 border rounded mb-2" style="max-height: 16rem;">
                        <t t-if="!state.chosen.length">
                            <div class="p-3 text-muted">
                                Toca las flores y el material de la izquierda para ir montando el ramo.
                            </div>
                        </t>
                        <div t-foreach="state.chosen" t-as="item" t-key="item.product.id"
                             class="d-flex align-items-center gap-2 p-2 border-bottom">
                            <span class="flex-grow-1" t-esc="item.product.display_name"/>
                            <button class="btn btn-sm btn-secondary" t-on-click="() => this.step(item, -1)">-</button>
                            <input type="text" class="form-control form-control-sm text-center"
                                   style="width: 4rem;"
                                   t-att-value="item.qty"
                                   t-on-change="(ev) => this.setQty(item, ev)"/>
                            <button class="btn btn-sm btn-secondary" t-on-click="() => this.step(item, 1)">+</button>
                            <button class="btn btn-sm btn-link text-danger" t-on-click="() => this.remove(item)">
                                Quitar
                            </button>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <label class="mb-0 flex-grow-1">Precio del ramo</label>
                        <input type="text" class="form-control form-control-lg text-end"
                               style="width: 8rem;"
                               t-att-value="price"
                               t-on-change="(ev) => this.setPrice(ev)"/>
                        <span t-esc="props.currency"/>
                    </div>
                    <small class="text-muted mt-1">
                        Sugerido por lo que lleva: <t t-esc="suggestedPrice"/> <t t-esc="props.currency"/>.
                        Puedes cobrarlo a otro precio.
                    </small>
                </div>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-primary btn-lg lh-lg"
                        t-att-disabled="!isValid" t-on-click="confirm">
                    Añadir al ticket
                </button>
                <button class="btn btn-secondary btn-lg lh-lg" t-on-click="cancel">
                    Cancelar
                </button>
            </t>
        </Dialog>
    </t>
</templates>
