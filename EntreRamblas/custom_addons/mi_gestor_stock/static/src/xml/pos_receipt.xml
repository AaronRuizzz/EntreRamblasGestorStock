<?xml version="1.0" encoding="UTF-8"?>
<!-- Quita "Powered by Odoo" de la pantalla de recibo tras cobrar. El
     ticket que sale por la térmica ya está limpio (va por models/mgs_escpos.py);
     esto es solo lo que se ve EN PANTALLA, incluido si se usa la impresión
     por navegador cuando la térmica está desactivada. -->
<templates id="template" xml:space="preserve">
    <t t-name="mi_gestor_stock.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//p[text()='Powered by Odoo']" position="replace"/>

        <!-- Hallazgo 23: la plantilla nativa aplica taxTotals.order_sign al
             TOTAL (más abajo, sin tocar) pero no al desglose de base e IVA:
             una devolución salía con base y cuota en positivo y solo el
             total en negativo. Se multiplica por el mismo order_sign, igual
             que ya hace el total. -->
        <xpath expr="//div[@class='d-flex']/span[contains(@t-esc,'subtotal.base_amount_currency')]"
               position="replace">
            <span t-esc="props.formatCurrency(taxTotals.order_sign * subtotal.base_amount_currency)"
                  class="ms-auto"/>
        </xpath>
        <xpath expr="//span[contains(@t-esc,'tax_group.base_amount_currency')]" position="replace">
            <span t-esc="props.formatCurrency(taxTotals.order_sign * tax_group.base_amount_currency)"/>
        </xpath>
        <xpath expr="//span[contains(@t-esc,'tax_group.tax_amount_currency')]" position="replace">
            <span t-esc="props.formatCurrency(taxTotals.order_sign * tax_group.tax_amount_currency)"
                  class="ms-auto"/>
        </xpath>
    </t>
</templates>
