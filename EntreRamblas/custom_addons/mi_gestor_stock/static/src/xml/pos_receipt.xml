<?xml version="1.0" encoding="UTF-8"?>
<!-- Quita "Powered by Odoo" de la pantalla de recibo tras cobrar. El
     ticket que sale por la térmica ya está limpio (va por models/mgs_escpos.py);
     esto es solo lo que se ve EN PANTALLA, incluido si se usa la impresión
     por navegador cuando la térmica está desactivada. -->
<templates id="template" xml:space="preserve">
    <t t-name="mi_gestor_stock.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//p[text()='Powered by Odoo']" position="replace"/>

        <!-- Ticket simplificado: solo productos con su precio final (IVA
             incluido, ver pos.config.iface_tax_included = "total") y el
             TOTAL. Se quita el bloque completo de base imponible, cuota y
             porcentaje (`pos-receipt-taxes`, con su primera línea de
             guiones); los cálculos fiscales de la venta no cambian. El
             TOTAL nativo conserva `taxTotals.order_sign`, así que una
             devolución sigue saliendo en negativo. -->
        <xpath expr="//div[contains(@class,'pos-receipt-taxes')]" position="replace"/>

        <!-- QR de reseña de Google y/o web de la tienda: los mismos datos
             que ya llevan el ticket térmico y el PDF de reimpresión
             (mgs_config.py, mgs_pos_receipt.py). Sin esto, el recibo que ve
             la clienta nada más cobrar —y lo que sale si ese recibo se
             imprime por el navegador, con la impresión térmica automática
             desactivada— se quedaba sin ellos aunque estuvieran
             configurados. `before-footer` es el punto de extensión que la
             propia plantilla nativa deja preparado para esto (ver su
             comentario: "prevents missing receipt elements in modules
             like..."). -->
        <xpath expr="//div[@class='before-footer']" position="after">
            <div t-if="props.data.mgs_review_qr or props.data.mgs_website_qr" class="text-center mb-2">
                <div t-if="props.data.mgs_review_qr" class="mb-2">
                    <div class="pos-receipt-order-data mb-1">Valóranos en Google</div>
                    <img t-att-src="'data:image/png;base64,' + props.data.mgs_review_qr" class="pos-receipt-logo"/>
                </div>
                <div t-if="props.data.mgs_website_qr">
                    <div class="pos-receipt-order-data mb-1" t-esc="props.data.mgs_website_url"/>
                    <img t-att-src="'data:image/png;base64,' + props.data.mgs_website_qr" class="pos-receipt-logo"/>
                </div>
            </div>
        </xpath>
    </t>
</templates>
