<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ Asistente: elegir el periodo ============ -->
    <record id="view_mgs_monthly_report_form" model="ir.ui.view">
        <field name="name">mgs.monthly.report.form</field>
        <field name="model">mgs.monthly.report</field>
        <field name="arch" type="xml">
            <form string="Informe mensual">
                <p class="text-muted">
                    Ventas y margen del periodo, con costes históricos. El inventario
                    mostrado corresponde al momento de consultar el informe.
                </p>
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="category_id"/>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Generar PDF"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    <button name="action_export_csv" type="object" string="Exportar ventas CSV"/>
                    <button name="action_export_all_csv" type="object" string="Exportar estadísticas (ZIP de CSV)"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mgs_monthly_report" model="ir.actions.act_window">
        <field name="name">Informe mensual (PDF)</field>
        <field name="res_model">mgs.monthly.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_mgs_monthly_report_form"/>
        <field name="target">new</field>
    </record>

    <!-- ============ Acción de informe ============ -->
    <record id="action_report_mgs_monthly" model="ir.actions.report">
        <field name="name">Informe mensual</field>
        <field name="model">mgs.monthly.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mi_gestor_stock.report_mgs_monthly_document</field>
        <field name="report_file">mi_gestor_stock.report_mgs_monthly_document</field>
        <field name="print_report_name">'Informe %s a %s' % (object.date_from, object.date_to)</field>
    </record>

    <!-- ============ Plantilla del PDF ============ -->
    <template id="report_mgs_monthly_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <t t-set="d" t-value="doc.mgs_get_report_data()"/>
                    <div class="page">
                        <style>
                            h3 { page-break-after: avoid; }
                            table { page-break-inside: avoid; }
                            tr { page-break-inside: avoid; }
                            th, td { padding: 4px 6px !important; }
                        </style>
                        <h2>Informe de stock y ventas</h2>
                        <p>
                            Del <strong t-esc="d['date_from']"/>
                            al <strong t-esc="d['date_to']"/>
                        </p>

                        <h3 class="mt-4">Resumen</h3>
                        <p t-if="d['missing_costs']" class="text-danger">
                            Hay operaciones sin coste histórico registrado. Los costes y márgenes del periodo están incompletos.
                        </p>
                        <p t-if="d['category']">Categoría: <strong t-esc="d['category']"/></p>
                        <table class="table table-sm">
                            <tbody>
                                <tr>
                                    <td>Ventas netas sin impuestos</td>
                                    <td class="text-end">
                                        <span t-esc="d['total_revenue']"
                                              t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Coste de lo vendido</td>
                                    <td class="text-end">
                                        <span t-esc="d['total_cost_sold']"
                                              t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/>
                                    </td>
                                </tr>
                                <tr class="fw-bold">
                                    <td>Margen bruto (no equivale a beneficio neto)</td>
                                    <td class="text-end">
                                        <span t-esc="d['gross_profit']"
                                              t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Valor de mercancía recibida (no implica pago)</td>
                                    <td class="text-end">
                                        <span t-esc="d['purchases']"
                                              t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/>
                                    </td>
                                </tr>
                                <tr class="fw-bold">
                                    <td>Impuestos de las ventas</td>
                                    <td class="text-end">
                                        <span t-esc="d['taxes']"
                                              t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Valor del stock actual (a coste)</td>
                                    <td class="text-end">
                                        <span t-esc="d['stock_value']"
                                              t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <h3>Actividad y mermas</h3>
                        <p>Tickets con venta: <strong t-esc="d['sale_ticket_count']"/>.
                           Tickets con devolución: <strong t-esc="d['refund_ticket_count']"/>.</p>
                        <p class="text-muted">El ticket medio incluye impuestos y solo las líneas vendidas,
                            antes de devoluciones. Si hay filtro, cuenta el importe de esa categoría por ticket afectado.</p>
                        <table class="table table-sm">
                            <tbody>
                                <tr t-foreach="[('Ventas antes de devoluciones, con impuestos', 'gross_sales_including_tax'), ('Devoluciones, con impuestos', 'refunds_including_tax'), ('Ticket medio de venta', 'average_sale_ticket'), ('Coste de mermas', 'scrap_cost'), ('Margen después de mermas (no es beneficio neto)', 'margin_after_scrap')]" t-as="metric">
                                    <td t-esc="metric[0]"/>
                                    <td class="text-end"><span t-esc="d[metric[1]]" t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h3>Cobros registrados</h3>
                        <p class="text-muted">Por fecha de pago. Incluyen impuestos; las salidas incluyen
                            cambios en efectivo y reembolsos. No representan la conciliación bancaria del datáfono.</p>
                        <p t-if="not d['payments_available']">Elimina el filtro de categoría para consultar los cobros completos.</p>
                        <table t-elif="d['payment_rows']" class="table table-sm">
                            <thead><tr><th>Método</th><th>Entradas</th><th>Salidas</th><th>Neto</th></tr></thead>
                            <tbody><tr t-foreach="d['payment_rows']" t-as="row">
                                <td t-esc="row['name']"/>
                                <td><span t-esc="row['received']" t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/></td>
                                <td><span t-esc="row['returned']" t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/></td>
                                <td><span t-esc="row['received'] - row['returned']" t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/></td>
                            </tr></tbody>
                        </table>
                        <p t-else="">No hay cobros registrados en este periodo.</p>

                        <h3 style="page-break-before: always;">Ventas por día (Europe/Madrid)</h3>
                        <table t-if="d['daily_rows']" class="table table-sm">
                            <thead><tr><th>Fecha</th><th>Ventas netas sin impuestos</th><th>Coste</th><th>Impuestos</th></tr></thead>
                            <tbody><tr t-foreach="d['daily_rows']" t-as="row">
                                <td t-esc="row['date']"/>
                                <td><span t-esc="row['revenue']" t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/></td>
                                <td><span t-esc="row['cost']" t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/></td>
                                <td><span t-esc="row['taxes']" t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/></td>
                            </tr></tbody>
                        </table>
                        <p t-else="">No hay ventas en este periodo.</p>

                        <h3>Detalle de mermas</h3>
                        <table t-if="d['scrap_rows']" class="table table-sm">
                            <thead><tr><th>Fecha</th><th>Referencia</th><th>Producto</th><th>Partida</th>
                                <th>Motivo</th><th>Cantidad</th><th>Registrado por</th><th>Coste</th></tr></thead>
                            <tbody><tr t-foreach="d['scrap_rows']" t-as="row">
                                <td t-esc="row['date']"/><td t-esc="row['reference']"/>
                                <td t-esc="row['product']"/><td t-esc="row['lot']"/><td t-esc="row['reason']"/>
                                <td><t t-esc="row['quantity']"/> <t t-esc="row['uom']"/></td>
                                <td t-esc="row['recorded_by']"/>
                                <td><span t-esc="row['cost']" t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/></td>
                            </tr></tbody>
                        </table>
                        <p t-else="">No hay mermas registradas en este periodo.</p>

                        <h3 class="mt-4">Productos vendidos</h3>
                        <table class="table table-sm" t-if="d['sold_rows']">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-end">Unidades</th>
                                    <th class="text-end">Ingresos</th>
                                    <th class="text-end">Coste</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="d['sold_rows']" t-as="row">
                                    <td t-esc="row['name']"/>
                                    <td class="text-end" t-esc="row['qty']"/>
                                    <td class="text-end">
                                        <span t-esc="row['revenue']"
                                              t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="row['cost']"
                                              t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold">
                                    <td>Total</td>
                                    <td class="text-end" t-esc="d['total_qty_sold']"/>
                                    <td class="text-end">
                                        <span t-esc="d['total_revenue']"
                                              t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="d['total_cost_sold']"
                                              t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                        <p t-else="" class="text-muted">No hubo ventas en este periodo.</p>

                        <h3 class="mt-4" t-if="d['events_available'] and d['event_rows']">Eventos y encargos</h3>
                        <p t-if="d['events_available'] and d['event_rows']" class="text-muted">
                            Por fecha del evento. La señal, la fianza y el alquiler no pasan
                            por la caja del TPV y no están en las ventas de arriba; lo que se
                            cobró en caja («Cobrar en caja» del encargo) sí está arriba y se
                            señala aparte para no contarlo dos veces. El material roto que
                            volvió aparece en las mermas.
                        </p>
                        <table class="table table-sm" t-if="d['events_available'] and d['event_rows']">
                            <thead>
                                <tr>
                                    <th>Referencia</th>
                                    <th>Cliente</th>
                                    <th>Fecha</th>
                                    <th>Estado</th>
                                    <th class="text-end">Total</th>
                                    <th class="text-end">Cobrado</th>
                                    <th class="text-end">Pendiente</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="d['event_rows']" t-as="row" t-key="row['name']">
                                    <td><span t-esc="row['name']"/></td>
                                    <td>
                                        <span t-esc="row['partner']"/>
                                        <span t-if="row['pending_return']" class="text-muted"> · material sin devolver</span>
                                    </td>
                                    <td><span t-esc="row['date']"/></td>
                                    <td><span t-esc="row['state']"/></td>
                                    <td class="text-end"><span t-esc="row['total']" t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/></td>
                                    <td class="text-end"><span t-esc="row['paid']" t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/></td>
                                    <td class="text-end"><span t-esc="row['due']" t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="4">Total comprometido en eventos del periodo</th>
                                    <th class="text-end"><span t-esc="d['event_total']" t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/></th>
                                    <th class="text-end" colspan="2">
                                        Cobrado en el periodo:
                                        <span t-esc="d['event_collected']" t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/>
                                        <span t-if="d['event_collected_pos']" class="text-muted d-block fw-normal">
                                            de ello, en caja (ya en las ventas de arriba):
                                            <span t-esc="d['event_collected_pos']" t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/>
                                        </span>
                                    </th>
                                </tr>
                            </tfoot>
                        </table>

                        <h3 class="mt-4">Stock restante</h3>
                        <table class="table table-sm" t-if="d['stock_rows']">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-end">Existencias</th>
                                    <th class="text-end">Valor a coste</th>
                                    <th>Caduca</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="d['stock_rows']" t-as="row">
                                    <td t-esc="row['name']"/>
                                    <td class="text-end">
                                        <t t-esc="row['qty']"/> <t t-esc="row['uom']"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="row['value']"
                                              t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/>
                                    </td>
                                    <td t-esc="row['expiry'] or ''"/>
                                </tr>
                            </tbody>
                        </table>
                        <p t-else="" class="text-muted">No queda stock registrado.</p>

                        <h3 class="mt-4">Consumo de flor y material</h3>
                        <p class="text-muted">
                            Cuánto se ha gastado de verdad de cada material, sea vendido
                            suelto, dentro de un ramo a medida o entregado en un evento.
                            Es informativo: el coste ya está contado en el margen de
                            arriba, dentro de la línea que se cobró (el ramo, no sus
                            flores por separado), así que no se suma otra vez.
                        </p>
                        <table class="table table-sm" t-if="d['consumption_rows']">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-end">Cantidad</th>
                                    <th class="text-end">Coste histórico</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="d['consumption_rows']" t-as="row">
                                    <td t-esc="row['name']"/>
                                    <td class="text-end">
                                        <t t-esc="row['qty']"/> <t t-esc="row['uom']"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="row['cost']"
                                              t-options="{'widget': 'monetary', 'display_currency': d['currency']}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <p t-else="" class="text-muted">No hay consumo registrado en el periodo.</p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
