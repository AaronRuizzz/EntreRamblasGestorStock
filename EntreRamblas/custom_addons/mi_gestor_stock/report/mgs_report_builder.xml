<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ Acción de informe ============ -->
    <record id="action_report_mgs_report_builder" model="ir.actions.report">
        <field name="name">Informe personalizado</field>
        <field name="model">mgs.report.template</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mi_gestor_stock.report_mgs_report_builder_document</field>
        <field name="report_file">mi_gestor_stock.report_mgs_report_builder_document</field>
        <field name="print_report_name">'%s %s a %s' % (object.name, object.date_from, object.date_to)</field>
    </record>

    <!-- ============ Plantilla del PDF ============
         Las tablas NO se escriben aquí una por una: se recorren las que
         devuelve `_mgs_sections()` (models/mgs_report_template.py), las
         mismas que usa el Excel. Así una columna añadida o quitada sale en
         las dos exportaciones a la vez y no pueden discrepar. -->
    <template id="report_mgs_report_builder_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <t t-set="d" t-value="doc.mgs_report_data()"/>
                    <div class="page">
                        <style>
                            h3 { page-break-after: avoid; }
                            table { page-break-inside: avoid; }
                            tr { page-break-inside: avoid; }
                            th, td { padding: 4px 6px !important; }
                        </style>

                        <div t-attf-class="p-2 mb-3 fw-bold text-white #{'bg-success' if doc.is_gestoria_master else 'bg-danger'}">
                            <span t-esc="doc._mgs_banner()"/>
                        </div>

                        <h2 t-esc="doc.name"/>
                        <p class="text-muted mb-1">
                            Generado el
                            <span t-esc="d['generated_at']"
                                  t-options="{'widget': 'datetime'}"/>
                            por <span t-esc="d['author']"/>.
                        </p>
                        <p class="text-muted">
                            <span t-esc="doc._mgs_criteria_text()"/>
                        </p>

                        <t t-foreach="doc._mgs_sections(d)" t-as="section">
                            <h3 class="mt-4" t-esc="section[0]"/>
                            <table class="table table-sm" t-if="section[2]">
                                <thead>
                                    <tr>
                                        <th t-foreach="section[1]" t-as="header" t-esc="header"/>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="section[2]" t-as="row">
                                        <td t-foreach="row" t-as="cell">
                                            <span t-if="cell is True">Sí</span>
                                            <span t-elif="cell is False">No</span>
                                            <span t-else="" t-esc="cell"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <p t-else="" class="text-muted">Sin datos en este periodo.</p>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
