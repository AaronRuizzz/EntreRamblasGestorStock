<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_mgs_event" model="ir.actions.report">
        <field name="name">Presupuesto del evento</field>
        <field name="model">mgs.event</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mi_gestor_stock.report_mgs_event</field>
        <field name="report_file">mi_gestor_stock.report_mgs_event</field>
        <field name="print_report_name">'Presupuesto %s' % object.name</field>
        <field name="binding_model_id" ref="model_mgs_event"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_mgs_event">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Presupuesto <span t-field="doc.name"/></h2>
                        <div class="row mb-4">
                            <div class="col-6">
                                <strong>Cliente</strong><br/>
                                <span t-field="doc.partner_id"/>
                            </div>
                            <div class="col-6">
                                <strong>Fecha del evento:</strong>
                                <span t-field="doc.event_date"/><br/>
                                <t t-if="doc.amount_deposit">
                                    <strong>Devolución del material:</strong>
                                    <span t-field="doc.return_date"/>
                                </t>
                            </div>
                        </div>

                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Concepto</th>
                                    <th class="text-center">Cantidad</th>
                                    <th class="text-end">Precio</th>
                                    <th class="text-end">Importe</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.line_ids" t-as="line" t-key="line.id">
                                    <td>
                                        <span t-field="line.product_id"/>
                                        <span t-if="line.is_rental" class="text-muted"> (alquiler, se devuelve)</span>
                                    </td>
                                    <td class="text-center"><span t-field="line.quantity"/></td>
                                    <td class="text-end"><span t-field="line.unit_price"/></td>
                                    <td class="text-end"><span t-field="line.subtotal"/></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="3" class="text-end">Total</th>
                                    <th class="text-end"><span t-field="doc.amount_total"/></th>
                                </tr>
                                <tr t-if="doc.amount_paid">
                                    <td colspan="3" class="text-end">Entregado a cuenta</td>
                                    <td class="text-end"><span t-field="doc.amount_paid"/></td>
                                </tr>
                                <tr t-if="doc.amount_paid">
                                    <th colspan="3" class="text-end">Pendiente</th>
                                    <th class="text-end"><span t-field="doc.amount_due"/></th>
                                </tr>
                            </tfoot>
                        </table>

                        <div t-if="doc.amount_deposit" class="mt-3">
                            <p>
                                <strong>Fianza del material de alquiler:
                                <span t-field="doc.amount_deposit"/></strong>.
                                Se devuelve al reintegrar el material completo y en buen estado.
                                El material que no vuelva o vuelva dañado se descontará de la fianza.
                            </p>
                        </div>

                        <div t-if="doc.note" class="mt-3">
                            <strong>Notas</strong>
                            <p t-field="doc.note"/>
                        </div>

                        <p class="text-muted mt-4">
                            Presupuesto sujeto a disponibilidad de flor de temporada. Las flores
                            naturales pueden variar de tono según el mercado del día.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
