<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==========================================================
         Pantalla de inicio tras el login
         ==========================================================
         Fijamos "Inventario > Resumen" como pantalla de inicio para
         el administrador y para la plantilla de usuarios nuevos. -->
    <function model="res.users" name="write">
        <value model="res.users"
               eval="[ref('base.user_admin'), ref('base.default_user')]"/>
        <value eval="{'action_id': ref('stock.stock_picking_type_action')}"/>
    </function>

    <!-- ==========================================================
         Ocultar aplicaciones y paneles técnicos que confunden
         ========================================================== -->
    <!-- 1. Conversaciones (chat interno) -->
    <record id="mail.menu_root_discuss" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- 2. Tableros / Informes complejos (Spreadsheet Dashboard) -->
    <record id="spreadsheet_dashboard.spreadsheet_dashboard_menu_root" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- 3. Catálogo de Apps (para no desconfigurar o instalar módulos por error) -->
    <record id="base.menu_management" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- ==========================================================
         Ocultar submenús innecesarios en Inventario
         Deja únicamente: Resumen, Recepciones, Ajustes y Productos
         ========================================================== -->
    <!-- Informes complejos de valoración y analíticas -->
    <record id="stock.menu_warehouse_report" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- Configuración técnica de inventario (rutas, almacenes, UoM) -->
    <record id="stock.menu_stock_config_settings" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- Reglas complejas de reabastecimiento automático -->
    <record id="stock.menu_stock_procurement" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- Transferencias entre múltiples almacenes (solo hay 1 tienda física) -->
    <record id="stock.menu_stock_transfers" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- Desechos avanzados -->
    <record id="stock.menu_stock_scrap" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

</odoo>
