<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==========================================================
         Pantalla de inicio tras el login
         ==========================================================
         La página de inicio: emblema, nombre de la tienda y acceso directo a
         Recepción, Stock e Informes. -->
    <!-- `tz` también aquí, no solo en _mgs_setup_spanish (que reescribe a
         los usuarios YA creados): esto es lo que copia un usuario nuevo al
         nacer de base.default_user. Sin ella, un alta después de quitar
         "Ajustes" (donde vivía Preferencias, la única pantalla que la
         corregía) se queda con `tz` vacío y sus horas se pintan en UTC. -->
    <function model="res.users" name="write">
        <value model="res.users"
               eval="[ref('base.user_admin'), ref('base.default_user')]"/>
        <value eval="{'action_id': ref('mi_gestor_stock.action_mgs_home'), 'tz': 'Europe/Madrid'}"/>
    </function>

    <!-- ==========================================================
         Salida del TPV: al cerrar una sesión, Odoo redirige a la
         acción cliente point_of_sale.action_client_pos_menu, que por
         defecto reabre point_of_sale.menu_point_root (justo el menú
         que desactivamos abajo). Sin este ajuste, salir del TPV
         dejaría al usuario en un menú inexistente. Ese <record> vive
         en un bloque noupdate="1" del módulo point_of_sale, así que
         hay que reapuntarlo desde Python (mismo patrón que
         base.main_company en res_company.py). -->
    <function model="ir.actions.client" name="write">
        <value model="ir.actions.client" eval="[ref('point_of_sale.action_client_pos_menu')]"/>
        <value eval="{'params': {'menu_id': ref('mi_gestor_stock.menu_mgs_root')}}"/>
    </function>

    <!-- ==========================================================
         Ocultar todas las apps, «Ajustes» incluido.
         ==========================================================
         Lista completa de los 9 menús raíz de esta instalación
         (verificada por consulta directa a ir_ui_menu). Antes se dejaba
         base.menu_administration (Ajustes) visible porque ya está
         restringido por grupo a administradores; se quita también: esta
         app es de gestión de tienda, no de administración de Odoo, y
         dentro de Ajustes había cosas que a una floristería no le hacen
         falta (Herramientas de desarrollador, Usuarios y compañías con
         la ficha nativa de permisos, configuración de Inventario/TPV/
         Facturación). El acceso técnico sigue existiendo por URL
         (`/odoo/settings`) para quien mantenga el equipo: desactivar el
         menú no revoca ningún permiso, solo lo saca de la barra. -->
    <record id="mail.menu_root_discuss" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="contacts.menu_contacts" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="spreadsheet_dashboard.spreadsheet_dashboard_menu_root" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="point_of_sale.menu_point_root" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="account.menu_finance" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="stock.menu_stock_root" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="base.menu_management" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="base.menu_tests" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="base.menu_administration" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <!-- ==========================================================
         Categorías de producto de fábrica: fuera del selector.
         ==========================================================
         Odoo precarga «Todo», «Todo/Vendible», «Todo/Gastos» y, con el
         TPV, «Todo/Vendible/TPV». Para la tienda no significan nada y solo
         estorban al elegir la categoría de un producto. Se archivan (campo
         `active`, añadido en models/product_category.py) para que
         desaparezcan de todos los desplegables. La dueña crea las suyas
         desde Recepción → «Producto nuevo» y quedan disponibles al instante.
         No se pueden borrar: Odoo las protege como categorías genéricas.

         Desde Python y no con <record>: las cuatro están en bloques
         noupdate="1" de `product` y `point_of_sale`, y un <record> sobre un
         xml_id así se salta en cada `-u` (solo valía al instalar). El porqué
         completo, en models/product_category.py. -->
    <function model="product.category" name="_mgs_archive_factory_categories" eval="[]"/>

    <!-- ==========================================================
         Las categorías del almacén son también las de la caja.
         ==========================================================
         Va DESPUÉS de archivar las de fábrica (arriba): así no se les crea
         botón en el TPV. Repasa la lista entera en cada `-u`, no solo al
         instalar, para que una base que ya viene con categorías y productos
         de antes se ponga al día de una vez. El detalle, en
         models/product_category.py.

         Los dos van con `eval="[]"` y no con la lista de ids de branding.xml:
         son métodos `@api.model` y `call_kw` les pasa tal cual lo que haya
         aquí, sin quitarle delante los ids. -->
    <function model="product.category" name="_mgs_sync_all_pos_categories" eval="[]"/>
</odoo>
