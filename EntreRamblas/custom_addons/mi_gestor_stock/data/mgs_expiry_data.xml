<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Numeración de las propuestas de baja de caducados. -->
        <record id="seq_mgs_expiry_writeoff" model="ir.sequence">
            <field name="name">Bajas de caducados</field>
            <field name="code">mgs.expiry.writeoff</field>
            <field name="prefix">CAD/%(year)s/</field>
            <field name="implementation">standard</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>

    <!-- Una vez al día: detecta lo caducado más allá del margen configurado
         y refresca la propuesta abierta. Nunca confirma solo (ver
         models/mgs_expiry.py). -->
    <record id="ir_cron_mgs_expiry_detect" model="ir.cron">
        <field name="name">Gestor de stock: detectar caducados para dar de baja</field>
        <field name="model_id" ref="model_mgs_expiry_writeoff"/>
        <field name="state">code</field>
        <field name="code">model._mgs_cron_detect_expired()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
