<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- La única plantilla que puede presentarse como informe para la
             gestoría: todas las secciones, sin filtros, bloqueada (ver
             models/mgs_report_template.py). El periodo se ajusta cada vez
             que se genera; el resto no se puede tocar. -->
        <record id="mgs_report_template_gestoria_completa" model="mgs.report.template">
            <field name="name">Gestoría completa</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="is_locked" eval="True"/>
            <field name="section_resumen" eval="True"/>
            <field name="section_ventas" eval="True"/>
            <field name="section_devoluciones" eval="True"/>
            <field name="section_cobros" eval="True"/>
            <field name="section_mermas" eval="True"/>
            <field name="section_stock" eval="True"/>
            <field name="section_consumo" eval="True"/>
            <field name="section_eventos" eval="True"/>
            <field name="section_correcciones" eval="True"/>
        </record>
    </data>
</odoo>
