<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Marca de la empresa: nombre, logo y favicon.

         NOTA: `base.main_company` se carga con noupdate="1" desde el
         modulo `base`, asi que un <record> normal para cambiar su
         nombre/logo se IGNORA en cada `-u`. Por eso se aplica desde
         codigo Python (models/res_company.py), que si se ejecuta
         siempre. El logo/favicon salen de los PNG del modulo para
         que viajen con el en el despliegue.
         ============================================================ -->
    <function model="res.company" name="_mgs_apply_branding" eval="[[]]"/>

    <!-- Plan contable espanol: una instalacion nueva se queda con el plan
         generico aunque l10n_es sea dependencia (ver el comentario junto al
         metodo, en models/res_company.py, con sus dos guardas). -->
    <function model="res.company" name="_mgs_ensure_spanish_chart" eval="[[]]"/>

    <!-- Idioma: toda la interfaz en espanol (es_ES) -->
    <function model="res.company" name="_mgs_setup_spanish" eval="[[]]"/>

    <!-- Caja de la tienda y sus tarifas: ver res_company._register_hook.
         NO va aqui (a diferencia del resto de esta lista): en una
         instalacion nueva, el plan contable espanol de arriba sustituye a
         los diarios/metodos de pago genericos, pero Odoo no los borra hasta
         el final de TODA la carga de modulos. Crear la caja aqui la dejaria
         enganchada a un diario que esa limpieza posterior borra en cascada,
         llevandose la caja por delante sin avisar. -->

    <!-- Numeracion de eventos y encargos: EVENTO/%(year)s/, no BODA/%(year)s/.
         El registro vive en data/mgs_event_data.xml con noupdate="1", asi
         que en una base ya instalada hay que forzarlo desde aqui (ver el
         comentario junto al metodo, en models/res_company.py). -->
    <function model="res.company" name="_mgs_apply_event_sequence" eval="[[]]"/>

    <!-- Remitente de correo local NO enrutable (entreramblas.invalid): abrir
         caja publica un mensaje con el usuario actual como autor y Odoo aborta
         si no hay remitente. El correo NO es un requisito de registro; la
         propietaria nunca escribe uno. Ver mgs.access._mgs_ensure_company_sender. -->
    <function model="mgs.access" name="_mgs_ensure_company_sender" eval="()"/>

    <!-- Sin registro publico de cuentas ("Don't have an account?"):
         solo el administrador crea usuarios. -->
    <function model="ir.config_parameter" name="set_param"
              eval="('auth_signup.allow_uninvited', 'False')"/>
    <function model="ir.config_parameter" name="set_param"
              eval="('auth_signup.invitation_scope', 'b2b')"/>

    <!-- Nombre del acceso directo que crea "Instalar aplicacion" (PWA).
         Sin esto, web/controllers/webmanifest.py usa 'Odoo' de fallback. Es
         el nombre del PRODUCTO (como el instalador), no la razón social del
         ticket: ver COMPANY_NAME arriba, que no se toca aquí. -->
    <function model="ir.config_parameter" name="set_param"
              eval="('web.web_app_name', 'Gestor Stock Clavel Y Azahar')"/>
</odoo>
