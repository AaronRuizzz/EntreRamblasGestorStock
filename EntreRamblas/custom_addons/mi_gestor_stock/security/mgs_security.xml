<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_mgs" model="ir.module.category">
        <field name="name">Floristería</field><field name="sequence">5</field>
    </record>
    <record id="group_mgs_user" model="res.groups">
        <field name="name">Dependienta</field>
        <field name="category_id" ref="module_category_mgs"/>
        <field name="implied_ids" eval="[(4,ref('point_of_sale.group_pos_user')),(4,ref('stock.group_stock_user')),(4,ref('stock.group_production_lot'))]"/>
    </record>
    <record id="group_mgs_manager" model="res.groups">
        <field name="name">Propietaria</field>
        <field name="category_id" ref="module_category_mgs"/>
        <field name="implied_ids" eval="[(4,ref('group_mgs_user')),(4,ref('point_of_sale.group_pos_manager')),(4,ref('stock.group_stock_manager')),(4,ref('product.group_product_pricelist'))]"/>
        <field name="users" eval="[(4,ref('base.user_admin'))]"/>
    </record>
</odoo>
