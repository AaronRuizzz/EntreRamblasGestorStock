# ============================================================
# Entre Ramblas · Clavel & Azahar — .gitignore
# Excluye datos locales, temporales, cachés y fuentes de Odoo
# ============================================================

# Odoo Core (fuente de Odoo clonado localmente, no debe subirse al repo de addons)
EntreRamblas/odoo/
odoo/

# Odoo: datos locales, filestore, sesiones, logs y runtime
EntreRamblas/.odoo_data/
.odoo_data/
**/.odoo_data/
**/filestore/
**/sessions/
*.log
*.err
*.pid
EntreRamblas/*.log
EntreRamblas/*.err
EntreRamblas/odoo-server.log
EntreRamblas/odoo-server.err
EntreRamblas/odoo-init.log
EntreRamblas/odoo-pos-init.log
EntreRamblas/pip-install.log

# Python: archivos compilados, cachés y bytecode
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.coverage
htmlcov/

# Entornos virtuales de Python
.venv/
venv/
env/
ENV/
EntreRamblas/.venv/
EntreRamblas/venv/
EntreRamblas/env/

# Configuración local, credenciales y secretos
*.local
*.secret
.env
.env.*
!.env.example

# Backups y volcados de bases de datos
# (las copias automaticas del Gestor de Stock, en .odoo_data/backups/ o en
#  la carpeta que se indique en Configuracion > Dispositivos)
backups/
mi_base_stock-*.zip
*.pgsql
*.dump
*.backup
*.sql
*.tar
*.gz

# Archivos de sistema operativo (Windows / macOS / Linux)
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
.AppleDouble
.LSOverride

# Editores e IDEs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iml
*.sublime-project
*.sublime-workspace

# Archivos temporales y de bloqueo
*.tmp
*.temp
*.swp
*.swo
*~
*-source-temp/
scratch/
